---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomePage, formatUrl } from '../utils/content';
import ProductCard from '../components/ProductCard.astro';
import CatalogDownloadBanner from '../components/CatalogDownloadBanner.astro';
import { Image } from 'astro:assets';
import heroBgImage from '../assets/images/substation-switchgear-control-room-lineup.jpeg';

const homeData = getHomePage();
const { meta, hero, featuredSolutions, manufacturingPillars, catalogCta } = homeData;
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Hero Section -->
  <section class="relative bg-slate-950 text-white overflow-hidden py-16 sm:py-24 lg:py-28 border-b border-slate-800">
    <!-- Background Image with Dark Gradient Overlay -->
    <div class="absolute inset-0 z-0 opacity-25">
      <Image
        src={heroBgImage}
        alt="Substation Control Room Lineup"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/90 to-blue-950/80"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/20 text-blue-300 text-xs font-semibold uppercase tracking-wider border border-blue-400/30 mb-6">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          {hero.badge}
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight">
          {hero.headline}
        </h1>

        <p class="mt-6 text-base sm:text-lg text-slate-300 leading-relaxed max-w-2xl">
          {hero.subheadline}
        </p>

        <!-- CTA Action Buttons -->
        <div class="mt-8 flex flex-wrap gap-4 items-center">
          <a
            href={formatUrl(hero.primaryCta.url)}
            class="px-6 py-3.5 text-sm font-bold rounded-lg bg-pptl-blue text-white hover:bg-blue-700 transition-all shadow-lg hover:shadow-blue-500/25 focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
          >
            {hero.primaryCta.label} &rarr;
          </a>

          <a
            href={formatUrl(hero.secondaryCta.url)}
            download="Pacific-Powertech-Catalog.pdf"
            class="px-6 py-3.5 text-sm font-semibold rounded-lg bg-slate-800/80 hover:bg-slate-700 text-white border border-slate-700 transition-all flex items-center gap-2 focus:ring-2 focus:ring-slate-500"
          >
            <svg class="w-4 h-4 text-pptl-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            {hero.secondaryCta.label}
          </a>

          <a
            href={hero.emergencyCta.url}
            class="inline-flex items-center text-xs font-semibold text-amber-400 hover:text-amber-300 gap-1.5 px-3 py-2 rounded-md hover:bg-slate-800/60 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"/>
            </svg>
            {hero.emergencyCta.label}
          </a>
        </div>
      </div>

      <!-- Key Statistics Bar -->
      <div class="mt-16 pt-10 border-t border-slate-800 grid grid-cols-2 lg:grid-cols-4 gap-6">
        {hero.stats.map((stat: any) => (
          <div class="bg-slate-900/60 p-4 rounded-xl border border-slate-800/80">
            <div class="text-2xl sm:text-3xl font-extrabold text-amber-400 tracking-tight">{stat.value}</div>
            <div class="text-sm font-bold text-white mt-1">{stat.label}</div>
            <div class="text-xs text-slate-400 mt-0.5">{stat.subtext}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Core Engineering Solutions Grid -->
  <section class="py-16 sm:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-bold uppercase tracking-widest text-pptl-blue">
        Power Systems Portfolio
      </h2>
      <p class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mt-2">
        {featuredSolutions.sectionTitle}
      </p>
      <p class="text-sm sm:text-base text-slate-600 mt-3 leading-relaxed">
        {featuredSolutions.sectionSubtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {featuredSolutions.items.map((item: any) => (
        <ProductCard
          title={item.title}
          image={item.image}
          summary={item.summary}
          highlights={item.highlights}
          url={item.url}
        />
      ))}
    </div>
  </section>

  <!-- Precision Engineering & Manufacturing Standards -->
  <section class="py-16 bg-slate-900 text-white border-y border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-xs font-bold uppercase tracking-widest text-amber-400">
          Build Quality & Reliability
        </h2>
        <p class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-2">
          {manufacturingPillars.title}
        </p>
        <p class="text-sm text-slate-300 mt-3">
          {manufacturingPillars.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {manufacturingPillars.pillars.map((pillar: any) => (
          <div class="bg-slate-800/80 p-6 rounded-xl border border-slate-700/80 flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-lg bg-pptl-blue flex items-center justify-center text-white mb-4 shadow-md">
                <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{pillar.title}</h3>
              <p class="text-xs text-slate-300 leading-relaxed">{pillar.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Catalog CTA Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CatalogDownloadBanner
      title={catalogCta.title}
      description={catalogCta.description}
    />
  </div>
</BaseLayout>

