---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHomePage, formatUrl } from '../utils/content';
import CatalogDownloadBanner from '../components/CatalogDownloadBanner.astro';
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';
import HorizontalProductRail from '../components/HorizontalProductRail.astro';

const homeData = getHomePage();
const { meta, hero, featuredSolutions, additionalProducts, manufacturingPillars, catalogCta } = homeData;

const heroBgImage = await resolveImage(hero.image);

// Resolve featured solution images
const solutionsWithImages = await Promise.all(
  featuredSolutions.items.map(async (item: any) => {
    const imgMeta = await resolveImage(item.image);
    return { ...item, imgMeta };
  })
);
---

<BaseLayout title={meta.title} description={meta.description} headerVariant="overlay">
  <section
    class="relative isolate overflow-hidden border-b-2 border-[#0C53A4] bg-[#031525] text-white"
    aria-labelledby="home-hero-title"
  >
    {heroBgImage && (
      <Image
        src={heroBgImage}
        alt=""
        class="home-hero-image absolute inset-0 -z-30 h-full w-full object-cover"
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="home-hero-overlay absolute inset-0 -z-20" aria-hidden="true"></div>

    <div class="mx-auto flex min-h-[640px] max-w-7xl items-center px-4 pb-20 pt-36 sm:px-6 sm:pb-24 sm:pt-40 lg:min-h-[690px] lg:px-8 lg:pb-28 lg:pt-44">
      <div class="max-w-5xl">
        <div class="mb-6 flex items-center gap-4 text-xs font-bold uppercase tracking-[0.24em] text-white/85 sm:text-sm">
          <span class="h-8 w-1 bg-[#FAB218]" aria-hidden="true"></span>
          <span>{hero.badge}</span>
        </div>

        <h1 id="home-hero-title" class="home-hero-title max-w-5xl font-heading font-bold text-white">
          {hero.headline}
        </h1>

        <p class="mt-7 max-w-3xl text-lg leading-relaxed text-white/85 sm:text-xl">
          {hero.subheadline}
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href={formatUrl(hero.primaryCta.url)}
            class="inline-flex min-h-12 items-center justify-center gap-4 bg-[#0C53A4] px-7 py-3 text-base font-bold text-white transition-colors hover:bg-[#084584] focus-visible:ring-2 focus-visible:ring-[#FAB218]"
          >
            {hero.primaryCta.label}
            <span aria-hidden="true">&rarr;</span>
          </a>

          <a
            href={formatUrl(hero.secondaryCta.url)}
            download="Pacific-Powertech-Catalog.pdf"
            class="inline-flex min-h-12 items-center justify-center bg-[#FAB218] px-7 py-3 text-base font-bold text-[#07131f] transition-colors hover:bg-[#f6c044] focus-visible:ring-2 focus-visible:ring-white"
          >
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>
    </div>

    <div class="relative z-10 border-t border-white/20 bg-[#031525]/[0.88]">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 divide-x divide-y divide-white/20 md:grid-cols-4 md:divide-y-0">
          {hero.capabilities.map((capability: any) => (
            <div class="flex min-h-24 items-center px-4 py-5 sm:px-6 lg:min-h-28 lg:px-8">
              <span class="max-w-[11rem] text-xs font-bold uppercase leading-snug tracking-[0.15em] text-white sm:text-sm">
                {capability.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <HorizontalProductRail
    title={additionalProducts.sectionTitle}
    subtitle={additionalProducts.sectionSubtitle}
    items={additionalProducts.items}
  />

  <!-- Core Engineering Portfolio: Alternating Structured Rows (Breaks up repetitive card grid) -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="mb-10 border-b border-slate-300 pb-6">
      <span class="block text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">
        Engineering Capabilities &bull; Technical Index
      </span>
      <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">
        {featuredSolutions.sectionTitle}
      </h2>
      <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
        {featuredSolutions.sectionSubtitle}
      </p>
    </div>

    <div class="border-b border-slate-300">
      {solutionsWithImages.map((sol, index) => {
        const isReversed = index % 2 !== 0;
        return (
          <article class="border-t border-slate-300 py-9 sm:py-12">
            <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-12">
              <!-- Image Column -->
              <div class={`lg:col-span-5 ${isReversed ? 'lg:order-2' : ''}`}>
                <div class="aspect-[16/10] overflow-hidden bg-slate-100">
                  {sol.imgMeta ? (
                    <Image
                      src={sol.imgMeta}
                      alt={sol.title}
                      class="h-full w-full object-cover transition-transform duration-200 hover:scale-[1.02]"
                      widths={[320, 480, 640]}
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center text-sm text-slate-500">Photo pending</div>
                  )}
                </div>
              </div>

              <!-- Information Column -->
              <div class={`space-y-4 lg:col-span-7 ${isReversed ? 'lg:order-1' : ''}`}>
                <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#0C53A4]">Industrial Power Systems</p>

                <h3 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
                  <a href={formatUrl(sol.url)} class="hover:text-[#0C53A4] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]">
                    {sol.title}
                  </a>
                </h3>

                <p class="text-base leading-7 text-slate-600">
                  {sol.summary}
                </p>

                <!-- Technical Specification Highlights -->
                {sol.highlights && sol.highlights.length > 0 && (
                  <div class="grid grid-cols-1 gap-x-7 gap-y-2 border-t border-slate-200 pt-4 sm:grid-cols-2">
                    {sol.highlights.map((item: string) => (
                      <div class="flex items-start gap-2 text-sm leading-6 text-slate-700">
                        <span class="font-bold text-[#0C53A4]">&ndash;</span>
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>
                )}

                <div class="pt-3">
                  <a
                    href={formatUrl(sol.url)}
                    class="inline-flex min-h-11 items-center border-b-2 border-[#0C53A4] text-sm font-bold text-[#0C53A4] hover:border-[#031525] hover:text-[#031525]"
                  >
                    <span>View Technical Specifications &amp; Data Sheet</span>
                    <span class="ml-1.5">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Manufacturing & Infrastructure Engineering Standards (Ruled Industrial Band) -->
  <section class="border-y border-white/10 bg-[#031525] py-14 text-white sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-9 border-b border-white/15 pb-5">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#FAB218]">
          Quality Assurance &bull; Factory Standards
        </span>
        <h2 class="mt-2 font-heading text-2xl font-bold tracking-tight text-white sm:text-3xl">
          {manufacturingPillars.title}
        </h2>
        <p class="mt-3 max-w-3xl text-base leading-7 text-slate-300">
          {manufacturingPillars.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-7 md:grid-cols-2 lg:grid-cols-4">
        {manufacturingPillars.pillars.map((pillar: any) => (
          <div class="space-y-2 border-l-2 border-white/25 py-1 pl-4 transition-colors hover:border-[#FAB218]">
            <h3 class="font-heading text-lg font-bold text-white">{pillar.title}</h3>
            <p class="text-sm leading-6 text-slate-300">{pillar.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Official Catalog Download Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CatalogDownloadBanner
      title={catalogCta.title}
      description={catalogCta.description}
    />
  </div>
</BaseLayout>
