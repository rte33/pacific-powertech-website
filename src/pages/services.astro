---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServicesPage, formatUrl } from '../utils/content';
import CatalogDownloadBanner from '../components/CatalogDownloadBanner.astro';

const servicesData = getServicesPage();
const { meta, header, servicesList, industriesServed, utilitiesInfrastructure } = servicesData;
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Page Header -->
  <section class="bg-[#070707] text-white py-12 sm:py-16 border-b-2 border-[#0C53A4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-2">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#FAB218] font-mono">
          Engineering &bull; Lifecycle Operations
        </span>
        <h1 class="font-heading text-3xl sm:text-5xl font-bold uppercase tracking-tight text-white leading-none">
          {header.title}
        </h1>
        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-sans pt-2">
          {header.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Core Engineering Services -->
  <section class="py-12 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-b border-gray-300 pb-3 mb-8">
      <span class="text-xs font-bold uppercase tracking-widest text-[#0C53A4] font-mono">
        Field Engineering
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950 mt-1">
        Comprehensive Substation &amp; Automation Services
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicesList.map((service: any, sIdx: number) => (
        <div class="bg-white p-6 border border-gray-300 border-t-2 border-t-[#0C53A4] flex flex-col justify-between space-y-3">
          <div>
            <span class="font-mono text-xs font-bold text-[#0C53A4]">SERVICE 0{sIdx + 1}</span>
            <h3 class="font-heading text-lg font-bold uppercase text-gray-950 mt-1 mb-2">{service.title}</h3>
            <p class="text-xs text-gray-600 leading-relaxed font-sans">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Sector Experience Grid -->
  <section class="py-12 bg-white border-y border-gray-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-b border-gray-200 pb-3 mb-8">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0C53A4] font-mono">
          Industry Deployments
        </span>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950 mt-1">
          {industriesServed.title}
        </h2>
        <p class="text-xs text-gray-600 font-sans mt-0.5">
          {industriesServed.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {industriesServed.sectors.map((sec: any) => (
          <div class="p-4 bg-[#F6F6F6] border border-gray-200 border-l-2 border-l-[#D81A21]">
            <h3 class="font-heading text-base font-bold uppercase text-gray-950 mb-1">{sec.name}</h3>
            <p class="text-xs text-gray-600 font-sans leading-relaxed">{sec.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Utilities & Environmental Infrastructure -->
  <section class="py-12 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-b border-gray-300 pb-3 mb-6">
      <h2 class="font-heading text-2xl font-bold uppercase tracking-tight text-gray-950">
        {utilitiesInfrastructure.title}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {utilitiesInfrastructure.items.map((util: any) => (
        <div class="p-5 bg-white border border-gray-300">
          <h3 class="font-heading text-base font-bold uppercase text-gray-950 mb-1">{util.name}</h3>
          <p class="text-xs text-gray-600 font-sans leading-relaxed">{util.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Direct AMC Callout Strip -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
    <div class="bg-[#070707] text-white p-8 border-l-4 border-l-[#FAB218] border border-gray-800 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="max-w-2xl space-y-1">
        <span class="text-xs font-bold uppercase tracking-wider text-[#FAB218] font-mono">Preventive Maintenance</span>
        <h2 class="font-heading text-2xl font-bold uppercase text-white">Need an Annual Maintenance Contract (AMC)?</h2>
        <p class="text-xs text-gray-400 font-sans leading-relaxed">
          Ensure zero downtime with scheduled thermographic scanning, transformer oil breakdown voltage testing, and 24/7 priority emergency response.
        </p>
      </div>
      <a
        href={formatUrl('/contact')}
        class="px-5 py-3 text-xs font-bold uppercase tracking-wider rounded-none bg-[#D81A21] text-white hover:bg-[#b5151c] transition-colors whitespace-nowrap shadow-xs"
      >
        Inquire About AMC &rarr;
      </a>
    </div>
  </section>

  <!-- Catalog Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CatalogDownloadBanner />
  </div>
</BaseLayout>
