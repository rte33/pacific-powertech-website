---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getServicesPage, formatUrl } from '../utils/content';
import CatalogDownloadBanner from '../components/CatalogDownloadBanner.astro';

const servicesData = getServicesPage();
const { meta, header, servicesList, industriesServed, utilitiesInfrastructure } = servicesData;
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-14 sm:py-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-amber-400 mb-3">
          {header.badge}
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
          {header.title}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          {header.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Core Engineering Services -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="text-xs font-bold uppercase tracking-widest text-pptl-blue">
        Field & Engineering Capabilities
      </h2>
      <p class="text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
        Full Lifecycle Engineering Support
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {servicesList.map((service: any) => (
        <div class="bg-white p-7 rounded-xl border border-slate-200 shadow-sm hover:border-blue-300 transition-all flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-pptl-blue flex items-center justify-center font-bold mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-2">{service.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Manufacturing & Industrial Sectors Served -->
  <section class="py-16 bg-slate-100 border-y border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-xs font-bold uppercase tracking-widest text-pptl-blue">
          Sector Experience
        </h2>
        <p class="text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
          {industriesServed.title}
        </p>
        <p class="text-slate-600 text-sm mt-2">
          {industriesServed.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {industriesServed.sectors.map((sec: any) => (
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="w-8 h-8 rounded bg-red-50 text-pptl-red flex items-center justify-center mb-3">
                <span class="text-xs font-bold">&bull;</span>
              </div>
              <h3 class="text-base font-bold text-slate-900 mb-2">{sec.name}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">{sec.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Utilities & Environmental Infrastructure -->
  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mb-10">
      <h2 class="text-xs font-bold uppercase tracking-widest text-pptl-blue">
        Public Utilities & Facilities
      </h2>
      <p class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mt-2">
        {utilitiesInfrastructure.title}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {utilitiesInfrastructure.items.map((util: any) => (
        <div class="p-6 rounded-xl bg-white border border-slate-200 shadow-sm">
          <h3 class="text-base font-bold text-slate-900 mb-2">{util.name}</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{util.description}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Direct AMC Quotation Box -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
    <div class="bg-slate-900 text-white rounded-2xl p-8 sm:p-10 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="max-w-2xl">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Scheduled Plant Reliability</span>
        <h2 class="text-2xl font-bold text-white mt-1">Need an Annual Maintenance Contract (AMC)?</h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-2">
          Keep your electrical transformers, VCB switchgear, and APFC plants operating at peak reliability with scheduled thermal scans, oil dielectric testing, and 24/7 priority emergency callouts.
        </p>
      </div>
      <a
        href={formatUrl('/contact')}
        class="px-6 py-3.5 text-xs sm:text-sm font-bold rounded-lg bg-pptl-red text-white hover:bg-red-700 transition-colors whitespace-nowrap shadow-md"
      >
        Inquire About AMC &rarr;
      </a>
    </div>
  </section>

  <!-- Catalog Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CatalogDownloadBanner />
  </div>
</BaseLayout>

