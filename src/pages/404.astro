---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatUrl } from '../utils/content';
---

<BaseLayout
  title="Page Not Found (404) | Pacific Powertech Ltd."
  description="The requested page could not be located. Browse Pacific Powertech's electrical substation and automation engineering solutions."
>
  <section class="py-20 sm:py-28 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-red-100 text-pptl-red mb-6 font-mono text-2xl font-bold">
      404
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight">
      Page Not Found
    </h1>

    <p class="mt-4 text-base text-slate-600 max-w-xl mx-auto leading-relaxed">
      The specification sheet, route, or resource you were searching for has moved or does not exist. Use the shortcuts below to return to our core power engineering solutions.
    </p>

    <!-- Quick Navigation Hub -->
    <div class="mt-10 max-w-2xl mx-auto bg-white p-6 rounded-2xl border border-slate-200 shadow-sm text-left">
      <h2 class="text-xs font-bold uppercase tracking-wider text-pptl-blue mb-4">
        Recommended Navigation Links
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
        <a href={formatUrl('/')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>Home</strong> &mdash; Main Portal
        </a>
        <a href={formatUrl('/about')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>About Us</strong> &mdash; Infrastructure & Lab
        </a>
        <a href={formatUrl('/products/transformers')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>Distribution Transformers</strong>
        </a>
        <a href={formatUrl('/products/lt-switchgear')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>LT Switchgear &amp; ACB</strong>
        </a>
        <a href={formatUrl('/products/pfi-systems')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>PFI Plants &amp; APFC</strong>
        </a>
        <a href={formatUrl('/products/ht-switchgear')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>11 kV HT Switchgear</strong>
        </a>
        <a href={formatUrl('/products/industrial-automation')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>PLC &amp; Automation Panels</strong>
        </a>
        <a href={formatUrl('/services')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>Engineering Services &amp; AMC</strong>
        </a>
        <a href={formatUrl('/contact')} class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>Contact Us</strong> &mdash; Head Works
        </a>
        <a href={formatUrl('/assets/PPL Catalog.pdf')} download="Pacific-Powertech-Catalog.pdf" class="p-2.5 rounded-lg hover:bg-slate-50 text-slate-700 hover:text-pptl-blue flex items-center gap-2 transition-colors">
          <span class="text-pptl-red">&rsaquo;</span>
          <strong>Catalog PDF (1.2 MB)</strong>
        </a>
      </div>
    </div>

    <div class="mt-8">
      <a
        href={formatUrl('/')}
        class="inline-flex items-center px-6 py-3 text-sm font-bold rounded-lg bg-pptl-blue text-white hover:bg-blue-800 transition-colors shadow-md"
      >
        &larr; Return to Homepage
      </a>
    </div>
  </section>
</BaseLayout>

