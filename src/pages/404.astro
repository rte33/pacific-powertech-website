---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatUrl } from '../utils/content';

const routes = [
  ['Home', '/'],
  ['About Pacific Powertech', '/about'],
  ['Products & Solutions', '/products'],
  ['Engineering Services', '/services'],
  ['Contact the engineering desk', '/contact'],
];
---

<BaseLayout
  title="Page Not Found (404) | Pacific Powertech Ltd."
  description="The requested page could not be located. Browse Pacific Powertech's electrical substation and automation engineering solutions."
>
  <section class="bg-[#031525] text-white">
    <div class="mx-auto grid min-h-[62vh] max-w-7xl gap-10 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-12 lg:items-center lg:px-8">
      <div class="lg:col-span-5"><p class="font-heading text-[clamp(7rem,18vw,15rem)] font-bold leading-none tracking-[-0.08em] text-[#0C53A4]" aria-hidden="true">404</p></div>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#FAB218]">Page not found</p>
        <h1 class="mt-4 font-heading text-4xl font-bold tracking-tight sm:text-6xl">We Can’t Find This Page.</h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">The page may have moved. Return to the main catalog or use one of the active routes below.</p>
        <nav class="mt-9 border-t border-white/20" aria-label="Useful routes">
          {routes.map(([label, href]) => <a href={formatUrl(href)} class="flex min-h-12 items-center justify-between border-b border-white/20 py-3 font-bold text-white hover:text-[#FAB218]"><span>{label}</span><span aria-hidden="true">→</span></a>)}
        </nav>
        <a href={formatUrl('/')} class="mt-8 inline-flex min-h-12 items-center bg-[#0C53A4] px-6 font-bold text-white hover:bg-[#084584]">Return to Homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>
