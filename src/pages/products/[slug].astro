---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllProductSlugs, getProductBySlug, formatUrl } from '../../utils/content';
import { resolveImage } from '../../utils/assets';
import { Image } from 'astro:assets';
import SpecTable from '../../components/SpecTable.astro';
import CatalogDownloadBanner from '../../components/CatalogDownloadBanner.astro';

export async function getStaticPaths() {
  const slugs = getAllProductSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const productData = getProductBySlug(slug as string);

if (!productData) {
  throw new Error(`Product data not found for slug: ${slug}`);
}

const { meta, product, parameters, features, specificationsTable } = productData;
const primaryImageMeta = product?.primaryImage ? await resolveImage(product.primaryImage) : null;

// Resolve gallery images
const galleryImgMetas = product?.gallery
  ? await Promise.all(
      product.gallery.map(async (imgName: string) => {
        const meta = await resolveImage(imgName);
        return { name: imgName, meta };
      })
    )
  : [];

// Schema.org Product structured data
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product?.name,
  "description": product?.shortDescription,
  "category": product?.category,
  "brand": {
    "@type": "Brand",
    "name": "Pacific Powertech Ltd."
  },
  "manufacturer": {
    "@type": "Organization",
    "name": "Pacific Powertech Ltd."
  }
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  productJsonLd={productJsonLd}
>
  <section class="border-b border-slate-300 bg-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-500" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2"><li><a href={formatUrl('/')} class="hover:text-[#0C53A4]">Home</a></li><li aria-hidden="true">/</li><li><a href={formatUrl('/products')} class="hover:text-[#0C53A4]">Products</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-[#031525]">{product.name}</li></ol>
      </nav>
      <div class="mt-9 grid gap-10 pb-10 lg:grid-cols-12 lg:items-center lg:pb-16">
        <div class="lg:col-span-7">
          <p class="inline-flex items-center gap-3 text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]"><span class="h-0.5 w-8 bg-[#D81A21]" aria-hidden="true"></span>{product.category || 'Substation Equipment'}</p>
          <h1 class="mt-5 max-w-4xl font-heading text-[clamp(2.8rem,6vw,5.5rem)] font-bold leading-[0.95] tracking-[-0.055em] text-[#031525]">{product.name}</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">{product.shortDescription}</p>
          <div class="mt-9 flex flex-wrap gap-4">
            <a href={formatUrl('/contact')} class="inline-flex min-h-12 items-center bg-[#0C53A4] px-6 font-bold text-white transition-colors hover:bg-[#084584]">Request Engineering Quotation <span class="ml-3" aria-hidden="true">→</span></a>
            <a href={formatUrl('/assets/PPL Catalog.pdf')} download="Pacific-Powertech-Catalog.pdf" class="inline-flex min-h-12 items-center border-b-2 border-[#031525] px-1 font-bold text-[#031525] hover:border-[#0C53A4] hover:text-[#0C53A4]">Download Catalog</a>
          </div>
        </div>
        <div class="relative lg:col-span-5">
          {primaryImageMeta && <Image src={primaryImageMeta} alt={product.name} class="aspect-square w-full object-cover" widths={[480, 720, 960]} loading="eager" />}
          <div class="absolute bottom-0 left-0 bg-[#031525] px-5 py-3 text-xs font-bold uppercase tracking-[0.14em] text-white">Made to project specification</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Operational Parameters -->
  {parameters && (
    <section class="border-b border-slate-300 bg-[#eef1f3] py-6">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <span class="mb-4 block text-xs font-bold uppercase tracking-[0.18em] text-slate-700">
          Verified Operating Ratings
        </span>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-6">
          {Object.entries(parameters).map(([key, val]) => (
            <div class="min-w-0 border-l-2 border-[#0C53A4] py-1 pl-3">
              <dt class="block break-words text-xs font-semibold uppercase tracking-[0.08em] text-slate-600">
                {key.replace(/([A-Z])/g, ' $1')}
              </dt>
              <dd class="mt-1 block break-words text-base font-bold text-[#031525] tabular-nums">
                {val}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <div class="mx-auto max-w-7xl space-y-16 px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <!-- Key Engineering Features -->
    {features && features.length > 0 && (
      <section>
        <div class="mb-7 border-b border-slate-300 pb-3">
          <h2 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
            Engineering &amp; Manufacturing Architecture
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-7 md:grid-cols-2 lg:grid-cols-3">
          {features.map((feature: any) => (
            <article class="space-y-2 border-t-2 border-[#0C53A4] pt-5">
              <h3 class="font-heading text-lg font-bold tracking-wide text-[#031525]">
                {feature.title}
              </h3>
              <p class="text-sm leading-6 text-slate-700">
                {feature.description}
              </p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Breaker Options (LT Switchgear) -->
    {productData.breakerOptions && (
      <section>
        <div class="mb-7 border-b border-slate-300 pb-3">
          <h2 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
            Available Breaker Configurations
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-4">
          {productData.breakerOptions.map((b: any) => (
            <article class="space-y-1 border-t-2 border-[#0C53A4] pt-5">
              <span class="block text-sm font-bold text-[#0C53A4] tabular-nums">{b.range}</span>
              <h3 class="font-heading text-base font-bold text-[#031525]">{b.type}</h3>
              <p class="text-sm leading-6 text-slate-700">{b.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- System Components (PFI Systems) -->
    {productData.systemComponents && (
      <section>
        <div class="mb-7 border-b border-slate-300 pb-3">
          <h2 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
            Core System Components
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-7 md:grid-cols-3">
          {productData.systemComponents.map((comp: any) => (
            <article class="border-t border-slate-300 pt-5">
              <h3 class="mb-1 font-heading text-base font-bold text-[#031525]">{comp.name}</h3>
              <p class="text-sm leading-6 text-slate-700">{comp.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Switchgear Variants & Protection (HT Switchgear) -->
    {productData.switchgearVariants && (
      <section>
        <div class="mb-7 border-b border-slate-300 pb-3">
          <h2 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
            Switchgear Panel Variants
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-7 md:grid-cols-3">
          {productData.switchgearVariants.map((v: any) => (
            <article class="border-l-2 border-[#0C53A4] py-1 pl-5">
              <h3 class="mb-1 font-heading text-lg font-bold text-[#031525]">{v.name}</h3>
              <p class="text-sm leading-6 text-slate-700">{v.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- 10 Catalog Benefits (Industrial Automation) -->
    {productData.benefits && (
      <section>
        <div class="mb-7 border-b border-slate-300 pb-3">
          <h2 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
            Operational Benefits of PPTL Automation
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
          {productData.benefits.map((ben: any) => (
            <article class="border-t border-slate-300 pt-5">
              <h3 class="mb-1 font-heading text-base font-bold text-[#031525]">{ben.title}</h3>
              <p class="text-sm leading-6 text-slate-700">{ben.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Accessories & Testing (Transformers) -->
    {productData.accessories && (
      <section>
        <div class="mb-7 border-b border-slate-300 pb-3">
          <h2 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
            Standard &amp; Optional Protection Accessories
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
          {productData.accessories.map((acc: any) => (
            <article class="border-t border-slate-300 pt-5">
              <h3 class="mb-1 font-heading text-base font-bold text-[#031525]">{acc.name}</h3>
              <p class="text-sm leading-6 text-slate-700">{acc.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Factory Testing Regime (Transformers) -->
    {productData.testsConducted && (
      <section class="border-l-4 border-[#FAB218] bg-[#031525] p-6 text-white sm:p-8">
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-[#FAB218]">
          Laboratory Standards
        </span>
        <h2 class="mb-2 mt-1 font-heading text-xl font-bold tracking-wide text-white sm:text-2xl">
          BSTI &amp; BUET Approved Testing Protocol
        </h2>
        <p class="mb-5 max-w-2xl text-sm leading-6 text-slate-300">
          Final tests executed strictly in accordance with IEC 76 on completely assembled transformers in our accredited facility.
        </p>
        <div class="grid grid-cols-1 gap-6 border-t border-white/15 pt-5 md:grid-cols-2">
          <div>
            <h3 class="mb-2.5 font-heading text-sm font-bold tracking-wider text-[#FAB218]">
              Routine Tests (100% Units)
            </h3>
            <ul class="space-y-1.5 text-sm text-slate-300">
              {productData.testsConducted.routineTests.map((t: string) => (
                <li class="flex items-center gap-2">
                  <span class="text-[#FAB218] font-bold">&check;</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="mb-2.5 font-heading text-sm font-bold tracking-wider text-[#FAB218]">
              Type Tests (Per Production Lot)
            </h3>
            <ul class="space-y-1.5 text-sm text-slate-300">
              {productData.testsConducted.typeTests.map((t: string) => (
                <li class="flex items-center gap-2">
                  <span class="text-[#D81A21] font-bold">&bull;</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- Engineering Specification Table -->
    {specificationsTable && (
      <section>
        <div class="mb-5 border-b border-slate-300 pb-3">
          <h2 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
            Engineering Specification Matrix
          </h2>
        </div>
        <SpecTable
          headers={specificationsTable.headers}
          rows={specificationsTable.rows}
          notes={specificationsTable.notes}
          caption={`${product.name} Specifications`}
        />
      </section>
    )}

    <!-- Component Image Gallery -->
    {galleryImgMetas.length > 0 && (
      <section>
        <div class="mb-5 border-b border-slate-300 pb-3">
          <h2 class="font-heading text-xl font-bold tracking-tight text-[#031525]">
            Assembly &amp; Hardware Details
          </h2>
        </div>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
          {galleryImgMetas.map((item) => (
            item.meta && (
              <div class="border border-slate-300 bg-white p-1">
                <Image
                  src={item.meta}
                  alt={`${product.name} hardware`}
                  class="h-28 w-full object-cover"
                  widths={[180, 320]}
                />
              </div>
            )
          ))}
        </div>
      </section>
    )}

    <!-- Catalog Download Banner -->
    <CatalogDownloadBanner />
  </div>
</BaseLayout>
