---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllProductSlugs, getProductBySlug, formatUrl } from '../../utils/content';
import { resolveImage } from '../../utils/assets';
import { Image } from 'astro:assets';
import SpecTable from '../../components/SpecTable.astro';
import CatalogDownloadBanner from '../../components/CatalogDownloadBanner.astro';

export async function getStaticPaths() {
  const slugs = getAllProductSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const productData = getProductBySlug(slug as string);

if (!productData) {
  throw new Error(`Product data not found for slug: ${slug}`);
}

const { meta, product, parameters, features, specificationsTable } = productData;

// Resolve primary image dynamically
const primaryImgMeta = product?.primaryImage ? await resolveImage(product.primaryImage) : null;

// Resolve gallery images
const galleryImgMetas = product?.gallery
  ? await Promise.all(
      product.gallery.map(async (imgName: string) => {
        const meta = await resolveImage(imgName);
        return { name: imgName, meta };
      })
    )
  : [];

// Schema.org Product structured data
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product?.name,
  "description": product?.shortDescription,
  "category": product?.category,
  "brand": {
    "@type": "Brand",
    "name": "Pacific Powertech Ltd."
  },
  "manufacturer": {
    "@type": "Organization",
    "name": "Pacific Powertech Ltd."
  }
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  productJsonLd={productJsonLd}
>
  <!-- Product Hero Header: Editorial Industrial Style -->
  <section class="bg-[#070707] text-white py-10 sm:py-14 border-b-2 border-[#0C53A4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-gray-400 mb-4" aria-label="Breadcrumb">
        <a href={formatUrl('/')} class="hover:text-white">HOME</a>
        <span>/</span>
        <a href={formatUrl('/products')} class="hover:text-white">PRODUCTS</a>
        <span>/</span>
        <span class="text-[#FAB218] uppercase">{product.name}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-block text-xs font-bold uppercase tracking-widest text-[#FAB218] bg-black/60 px-2.5 py-0.5 border border-[#FAB218]/40 font-mono">
            {product.category || 'Substation Equipment'}
          </div>
          <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold uppercase tracking-tight text-white">
            {product.name}
          </h1>
          <p class="text-sm text-gray-300 leading-relaxed font-sans max-w-2xl">
            {product.shortDescription}
          </p>

          <div class="pt-2 flex flex-wrap gap-3">
            <a
              href={formatUrl('/contact')}
              class="px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-none bg-[#0C53A4] text-white hover:bg-[#213C94] transition-colors focus:ring-2 focus:ring-[#0C53A4]"
            >
              Request Engineering Quotation &rarr;
            </a>
            <a
              href={formatUrl('/assets/PPL Catalog.pdf')}
              download="Pacific-Powertech-Catalog.pdf"
              class="px-4 py-2.5 text-xs font-semibold uppercase tracking-wider rounded-none border border-gray-600 text-gray-300 hover:bg-gray-800 transition-colors flex items-center gap-2"
            >
              <svg class="w-4 h-4 text-[#D81A21]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              Download Catalog PDF
            </a>
          </div>
        </div>

        {primaryImgMeta && (
          <div class="lg:col-span-5 bg-gray-900 border border-gray-700 p-1.5 shadow-lg">
            <Image
              src={primaryImgMeta}
              alt={product.name}
              class="w-full h-auto object-cover max-h-[350px]"
              loading="eager"
            />
            <div class="p-2 bg-black text-[11px] text-gray-400 font-mono flex justify-between border-t border-gray-800">
              <span>{product.name.toUpperCase()}</span>
              <span class="text-[#FAB218]">BSTI / IEC 76</span>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Key Operational Parameters Ribbon -->
  {parameters && (
    <section class="bg-white border-b border-gray-300 py-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="font-heading text-xs font-bold uppercase tracking-wider text-gray-700 block mb-2">
          Verified Operating Ratings
        </span>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
          {Object.entries(parameters).map(([key, val]) => (
            <div class="bg-[#F6F6F6] p-2.5 border border-gray-200">
              <span class="text-[10px] font-mono uppercase text-gray-700 block truncate font-semibold">
                {key.replace(/([A-Z])/g, ' $1')}
              </span>
              <span class="text-xs font-bold text-gray-900 font-sans mt-0.5 block truncate tabular-nums">
                {val}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Key Engineering Features -->
    {features && features.length > 0 && (
      <section>
        <div class="border-b border-gray-300 pb-2 mb-6">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950">
            Engineering &amp; Manufacturing Architecture
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {features.map((feature: any) => (
            <div class="bg-white p-5 border border-gray-300 border-t-2 border-t-[#0C53A4] space-y-2">
              <h3 class="font-heading text-lg font-bold uppercase tracking-wide text-gray-900">
                {feature.title}
              </h3>
              <p class="text-xs text-gray-700 leading-relaxed font-sans">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Breaker Options (LT Switchgear) -->
    {productData.breakerOptions && (
      <section>
        <div class="border-b border-gray-300 pb-2 mb-6">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950">
            Available Breaker Configurations
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {productData.breakerOptions.map((b: any) => (
            <div class="bg-white p-4 border border-gray-300 space-y-1">
              <span class="font-mono text-xs font-bold text-[#0C53A4] tabular-nums block">{b.range}</span>
              <h3 class="font-heading text-base font-bold uppercase text-gray-950">{b.type}</h3>
              <p class="text-xs text-gray-600 leading-relaxed font-sans">{b.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- System Components (PFI Systems) -->
    {productData.systemComponents && (
      <section>
        <div class="border-b border-gray-300 pb-2 mb-6">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950">
            Core System Components
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {productData.systemComponents.map((comp: any) => (
            <div class="bg-white p-4 border border-gray-300">
              <h3 class="font-heading text-base font-bold uppercase text-gray-950 mb-1">{comp.name}</h3>
              <p class="text-xs text-gray-600 leading-relaxed font-sans">{comp.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Switchgear Variants & Protection (HT Switchgear) -->
    {productData.switchgearVariants && (
      <section>
        <div class="border-b border-gray-300 pb-2 mb-6">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950">
            Switchgear Panel Variants
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {productData.switchgearVariants.map((v: any) => (
            <div class="bg-white p-5 border border-gray-300 border-l-4 border-l-[#0C53A4]">
              <h3 class="font-heading text-lg font-bold uppercase text-gray-950 mb-1">{v.name}</h3>
              <p class="text-xs text-gray-600 leading-relaxed font-sans">{v.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 10 Catalog Benefits (Industrial Automation) -->
    {productData.benefits && (
      <section>
        <div class="border-b border-gray-300 pb-2 mb-6">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950">
            Operational Benefits of PPTL Automation
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
          {productData.benefits.map((ben: any) => (
            <div class="bg-white p-3.5 border border-gray-300 flex flex-col justify-between">
              <span class="font-mono text-xs font-bold text-[#FAB218]">{ben.number}</span>
              <div class="mt-2">
                <h3 class="font-heading text-sm font-bold uppercase text-gray-950 mb-0.5">{ben.title}</h3>
                <p class="text-[11px] text-gray-600 font-sans">{ben.description}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Accessories & Testing (Transformers) -->
    {productData.accessories && (
      <section>
        <div class="border-b border-gray-300 pb-2 mb-6">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950">
            Standard &amp; Optional Protection Accessories
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {productData.accessories.map((acc: any) => (
            <div class="bg-white p-3.5 border border-gray-300">
              <h3 class="font-heading text-sm font-bold uppercase text-gray-950 mb-0.5">{acc.name}</h3>
              <p class="text-xs text-gray-600 font-sans leading-relaxed">{acc.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Factory Testing Regime (Transformers) -->
    {productData.testsConducted && (
      <section class="bg-[#070707] text-white p-6 sm:p-8 border border-gray-800 border-l-4 border-l-[#FAB218]">
        <span class="text-xs font-bold uppercase tracking-widest text-[#FAB218] font-mono">
          Laboratory Standards
        </span>
        <h2 class="font-heading text-xl sm:text-2xl font-bold uppercase tracking-wide text-white mt-1 mb-2">
          BSTI &amp; BUET Approved Testing Protocol
        </h2>
        <p class="text-xs text-gray-400 mb-5 max-w-2xl font-sans">
          Final tests executed strictly in accordance with IEC 76 on completely assembled transformers in our accredited facility.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2 border-t border-gray-800">
          <div>
            <h3 class="font-heading text-sm font-bold uppercase tracking-wider text-[#FAB218] mb-2.5">
              Routine Tests (100% Units)
            </h3>
            <ul class="space-y-1 text-xs text-gray-300 font-sans">
              {productData.testsConducted.routineTests.map((t: string) => (
                <li class="flex items-center gap-2">
                  <span class="text-[#FAB218] font-bold">&check;</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="font-heading text-sm font-bold uppercase tracking-wider text-[#FAB218] mb-2.5">
              Type Tests (Per Production Lot)
            </h3>
            <ul class="space-y-1 text-xs text-gray-300 font-sans">
              {productData.testsConducted.typeTests.map((t: string) => (
                <li class="flex items-center gap-2">
                  <span class="text-[#D81A21] font-bold">&bull;</span>
                  <span>{t}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- Engineering Specification Table -->
    {specificationsTable && (
      <section>
        <div class="border-b border-gray-300 pb-2 mb-4">
          <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950">
            Engineering Specification Matrix
          </h2>
        </div>
        <SpecTable
          headers={specificationsTable.headers}
          rows={specificationsTable.rows}
          notes={specificationsTable.notes}
          caption={`${product.name} Specifications`}
        />
      </section>
    )}

    <!-- Component Image Gallery -->
    {galleryImgMetas.length > 0 && (
      <section>
        <div class="border-b border-gray-300 pb-2 mb-4">
          <h2 class="font-heading text-xl font-bold uppercase tracking-tight text-gray-950">
            Assembly &amp; Hardware Details
          </h2>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
          {galleryImgMetas.map((item) => (
            item.meta && (
              <div class="bg-white border border-gray-300 p-1">
                <Image
                  src={item.meta}
                  alt={`${product.name} hardware`}
                  class="w-full h-28 object-cover"
                  widths={[180, 320]}
                />
              </div>
            )
          ))}
        </div>
      </section>
    )}

    <!-- Catalog Download Banner -->
    <CatalogDownloadBanner />
  </div>
</BaseLayout>
