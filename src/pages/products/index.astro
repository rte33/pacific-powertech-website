---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomePage, formatUrl } from '../../utils/content';
import ProductCard from '../../components/ProductCard.astro';
import CatalogDownloadBanner from '../../components/CatalogDownloadBanner.astro';

const homeData = getHomePage();
const products = homeData.featuredSolutions.items;
---

<BaseLayout
  title="Electrical Substation Products & Automation Solutions | Pacific Powertech Ltd."
  description="Explore Pacific Powertech's industrial product portfolio: Distribution Transformers (100–3000 kVA), LT/HT Switchgear, PFI Plants, and PLC Automation in Bangladesh."
>
  <!-- Page Header -->
  <section class="bg-[#070707] text-white py-12 sm:py-16 border-b-2 border-[#0C53A4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-2">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#FAB218] font-mono">
          Engineering &bull; Manufacturing Catalog
        </span>
        <h1 class="font-heading text-3xl sm:text-5xl font-bold uppercase tracking-tight text-white leading-none">
          Products &amp; Engineered Systems
        </h1>
        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-sans pt-2">
          Custom-designed, factory-tested electrical substation equipment and automation control architectures built in compliance with IEC 76, BS, ANSI, and VDE standards.
        </p>
      </div>
    </div>
  </section>

  <!-- Product Catalog Grid -->
  <section class="py-12 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-b border-gray-300 pb-3 mb-8">
      <h2 class="font-heading text-2xl font-bold uppercase text-gray-950">
        Primary Equipment Classifications
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map((item: any) => (
        <ProductCard
          title={item.title}
          image={item.image}
          summary={item.summary}
          highlights={item.highlights}
          url={item.url}
        />
      ))}
    </div>
  </section>

  <!-- Technical Inquiry Callout -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-10">
    <div class="bg-white border-l-4 border-l-[#0C53A4] border border-gray-300 p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div>
        <h2 class="font-heading text-xl sm:text-2xl font-bold uppercase text-gray-950">Custom Substation or Utility Tender Specifications?</h2>
        <p class="text-xs sm:text-sm text-gray-600 mt-1 max-w-2xl font-sans">
          We manufacture equipment tailored to local utility guidelines (DESCO, DPDC, BPDB, BREB). Contact our design engineers directly for custom drawings and single-line diagrams.
        </p>
      </div>
      <a
        href={formatUrl('/contact')}
        class="px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-none bg-[#0C53A4] text-white hover:bg-[#213C94] transition-colors whitespace-nowrap shadow-xs"
      >
        Submit Technical RFQ &rarr;
      </a>
    </div>
  </section>

  <!-- Catalog Download Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CatalogDownloadBanner />
  </div>
</BaseLayout>
