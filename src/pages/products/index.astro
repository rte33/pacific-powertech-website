---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomePage, formatUrl } from '../../utils/content';
import { Image } from 'astro:assets';
import { resolveImage } from '../../utils/assets';
import CatalogDownloadBanner from '../../components/CatalogDownloadBanner.astro';
import HorizontalProductRail from '../../components/HorizontalProductRail.astro';

const homeData = getHomePage();
const products = homeData.featuredSolutions.items;
const additionalProducts = homeData.additionalProducts;
const coverImage = await resolveImage('ht-switchgear-vcb-cubicles-lineup.jpeg');
const productsWithImages = await Promise.all(products.map(async (item: any) => ({ ...item, imgMeta: await resolveImage(item.image) })));
---

<BaseLayout
  title="Electrical Substation Products & Automation Solutions | Pacific Powertech Ltd."
  description="Explore Pacific Powertech's industrial product portfolio: Distribution Transformers (100–3000 kVA), LT/HT Switchgear, PFI Plants, and PLC Automation in Bangladesh."
>
  <section class="bg-[#031525] text-white">
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <nav class="text-sm text-slate-400" aria-label="Breadcrumb"><ol class="flex items-center gap-2"><li><a href={formatUrl('/')} class="hover:text-white">Home</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-white">Products &amp; Solutions</li></ol></nav>
      <div class="mt-9 grid gap-10 pb-14 lg:grid-cols-12 lg:items-center lg:pb-20">
        <div class="lg:col-span-7">
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#FAB218]">Engineering · Manufacturing Catalog</p>
          <h1 class="mt-5 font-heading text-[clamp(3rem,6vw,6rem)] font-bold leading-[0.94] tracking-[-0.055em]">Products &amp; Engineered Systems</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">Custom-designed, factory-tested electrical substation equipment and automation architectures built to IEC, BS, ANSI and VDE requirements.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={formatUrl('/contact')} class="inline-flex min-h-12 items-center bg-[#0C53A4] px-6 font-bold text-white transition-colors hover:bg-[#084584]">Request Technical RFQ <span class="ml-3" aria-hidden="true">→</span></a>
            <a href={formatUrl('/assets/PPL Catalog.pdf')} download="Pacific-Powertech-Catalog.pdf" class="inline-flex min-h-12 items-center border-b-2 border-white/70 px-1 font-bold text-white hover:border-[#FAB218] hover:text-[#FAB218]">Download Catalog</a>
          </div>
        </div>
        <div class="relative lg:col-span-5">
          {coverImage && <Image src={coverImage} alt="11 kV switchgear cubicle lineup" class="aspect-[5/4] w-full object-cover" widths={[480, 720, 960]} loading="eager" />}
          <div class="absolute bottom-0 left-0 bg-[#FAB218] px-5 py-3 text-sm font-bold text-[#031525]">Factory-tested assemblies</div>
        </div>
      </div>
      <dl class="grid border-t border-white/20 sm:grid-cols-3">
        <div class="border-b border-white/20 py-5 sm:border-b-0 sm:border-r sm:pr-6"><dt class="text-xs uppercase tracking-[0.16em] text-slate-400">Transformer Range</dt><dd class="mt-1 font-heading text-2xl font-bold">100–3000 kVA</dd></div>
        <div class="border-b border-white/20 py-5 sm:border-b-0 sm:border-r sm:px-6"><dt class="text-xs uppercase tracking-[0.16em] text-slate-400">LV Bus Rating</dt><dd class="mt-1 font-heading text-2xl font-bold">Up to 6300 A</dd></div>
        <div class="py-5 sm:pl-6"><dt class="text-xs uppercase tracking-[0.16em] text-slate-400">Medium Voltage</dt><dd class="mt-1 font-heading text-2xl font-bold">11 kV Systems</dd></div>
      </dl>
    </div>
  </section>

  <HorizontalProductRail title={additionalProducts.sectionTitle} subtitle={additionalProducts.sectionSubtitle} items={additionalProducts.items} />

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-5"><p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">Primary Systems</p><h2 class="mt-3 font-heading text-3xl font-bold text-[#031525] sm:text-4xl">Equipment Classifications</h2></div>
      <p class="text-base leading-7 text-slate-600 lg:col-span-6 lg:col-start-7">Each system is engineered around the project load schedule, utility requirements, protection study and site conditions.</p>
    </div>

    <div class="mt-12 border-t border-slate-300">
      {productsWithImages.map((item: any) => (
        <article class="grid gap-7 border-b border-slate-300 py-9 md:grid-cols-12 md:items-center">
          <div class="md:col-span-5">
            {item.imgMeta && <Image src={item.imgMeta} alt={item.title} class="aspect-[16/10] w-full object-cover" widths={[360, 560, 720]} />}
          </div>
          <div class="md:col-span-7 md:pl-5">
            <h3 class="font-heading text-2xl font-bold text-[#031525]">{item.title}</h3>
            <p class="mt-3 max-w-2xl text-base leading-7 text-slate-600">{item.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-slate-700">
              {item.highlights.map((highlight: string) => <li class="before:mr-2 before:text-[#0C53A4] before:content-['—']">{highlight}</li>)}
            </ul>
            <a href={formatUrl(item.url)} class="mt-6 inline-flex min-h-11 items-center border-b-2 border-[#0C53A4] font-bold text-[#0C53A4] hover:border-[#031525] hover:text-[#031525]">View system details <span class="ml-3" aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-10 sm:px-6 lg:px-8">
    <div class="grid gap-6 border-l-4 border-[#FAB218] bg-[#031525] p-7 text-white md:grid-cols-[1fr_auto] md:items-center md:p-9">
      <div><h2 class="font-heading text-2xl font-bold">Working With a Custom Substation or Utility Tender?</h2><p class="mt-2 max-w-3xl text-sm leading-7 text-slate-300">Our design engineers can prepare custom drawings and single-line diagrams aligned with DESCO, DPDC, BPDB and BREB requirements.</p></div>
      <a href={formatUrl('/contact')} class="inline-flex min-h-12 items-center bg-[#0C53A4] px-6 font-bold text-white hover:bg-[#084584]">Submit Technical RFQ <span class="ml-3" aria-hidden="true">→</span></a>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><CatalogDownloadBanner /></div>
</BaseLayout>
