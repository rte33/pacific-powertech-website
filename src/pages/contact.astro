---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContactPage, formatUrl } from '../utils/content';

const contactData = getContactPage();
const { meta, header, office, contactNumbers, emails, businessHours, prefilledInquiries } = contactData;
---

<BaseLayout title={meta.title} description={meta.description}>
  <section class="border-b-4 border-[#0C53A4] bg-[#031525] text-white">
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 sm:pb-20 lg:px-8">
      <nav class="text-sm text-slate-300" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2">
          <li><a href={formatUrl('/')} class="hover:text-white">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-white">Contact Us</li>
        </ol>
      </nav>

      <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#FAB218]">Direct Engineering Desk</p>
          <h1 class="mt-5 max-w-4xl font-heading text-[clamp(3rem,6vw,5.5rem)] font-bold leading-[0.96] tracking-[-0.055em]">{header.title}</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-300">{header.subtitle}</p>
        </div>

        <aside class="lg:col-span-4 lg:col-start-9" aria-label="Priority contact channels">
          <p class="text-sm font-semibold text-slate-300">For the fastest technical response</p>
          <div class="mt-4 border-t border-white/25">
            <a href={contactNumbers[0].telLink} class="group block border-b border-white/25 py-5">
              <span class="block text-sm font-semibold text-slate-300">24/7 engineering hotline</span>
              <span class="mt-1 flex items-center justify-between text-2xl font-bold tabular-nums group-hover:text-[#FAB218]">
                {contactNumbers[0].phone}<span aria-hidden="true">↗</span>
              </span>
            </a>
            <a href={emails[0].mailtoLink} class="group block border-b border-white/25 py-5">
              <span class="block text-sm font-semibold text-slate-300">Technical email</span>
              <span class="mt-1 flex min-w-0 items-center justify-between gap-4 break-words text-lg font-bold group-hover:text-[#FAB218]">
                {emails[0].email}<span class="shrink-0" aria-hidden="true">↗</span>
              </span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="bg-[#f3f5f6] py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <aside class="lg:col-span-4" aria-labelledby="office-heading">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#0C53A4]">Office &amp; Manufacturing Works</p>
        <h2 id="office-heading" class="mt-2 font-heading text-3xl font-bold tracking-tight text-[#031525]">{office.name}</h2>
        <address class="mt-5 not-italic text-base leading-7 text-slate-700">
          {office.addressLine1}<br />
          {office.addressLine2}<br />
          {office.country}
        </address>
        <a href={office.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex min-h-11 items-center border-b-2 border-[#0C53A4] font-bold text-[#0C53A4] hover:border-[#031525] hover:text-[#031525]">
          Open in Google Maps <span class="ml-3" aria-hidden="true">↗</span>
        </a>

        <div class="mt-10 border-t border-slate-300 pt-6">
          <h3 class="font-heading text-xl font-bold text-[#031525]">Availability</h3>
          <dl class="mt-4 space-y-3 text-sm leading-6 text-slate-700">
            <div><dt class="font-bold text-[#031525]">Working hours</dt><dd>{businessHours.weekdays}</dd></div>
            <div><dt class="font-bold text-[#031525]">Weekend</dt><dd>{businessHours.weekend}</dd></div>
          </dl>
          <p class="mt-4 border-l-2 border-[#D81A21] pl-4 text-sm font-semibold leading-6 text-[#031525]">{businessHours.emergencyNote}</p>
        </div>

        <div class="mt-10 border-t border-slate-300 pt-6">
          <h3 class="font-heading text-xl font-bold text-[#031525]">Direct lines</h3>
          <div class="mt-3 divide-y divide-slate-300 border-b border-slate-300">
            {contactNumbers.map((number: any) => (
              <a href={number.telLink} class="group block py-4">
                <span class="block text-sm text-slate-600">{number.label}</span>
                <span class="mt-1 block text-lg font-bold text-[#031525] tabular-nums group-hover:text-[#0C53A4]">{number.phone}</span>
              </a>
            ))}
          </div>
        </div>
      </aside>

      <div class="border-t-4 border-[#0C53A4] bg-white p-6 shadow-[0_14px_40px_rgba(3,21,37,0.08)] sm:p-9 lg:col-span-7 lg:col-start-6 lg:p-12">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#0C53A4]">Project Inquiry</p>
        <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">Tell Us What You’re Building.</h2>
        <p class="mt-4 max-w-2xl text-base leading-7 text-slate-600">Share the load, equipment category, site location and expected delivery window. Submitting opens a prepared email to our engineering team.</p>

        <form id="direct-inquiry-form" class="mt-9 space-y-6">
          <div>
            <label for="form-name" class="mb-2 block text-sm font-bold text-[#031525]">Full name and designation</label>
            <input type="text" id="form-name" name="name" autocomplete="name" required placeholder="e.g., Engr. Kabir Hossain, General Manager…" class="min-h-[3.25rem] w-full border border-slate-300 bg-[#f6f7f8] px-4 py-3 text-base text-[#031525] placeholder:text-slate-500 focus-visible:border-[#0C53A4] focus-visible:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]/25" />
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="form-company" class="mb-2 block text-sm font-bold text-[#031525]">Company or plant name</label>
              <input type="text" id="form-company" name="company" autocomplete="organization" required placeholder="e.g., Company or plant name…" class="min-h-[3.25rem] w-full border border-slate-300 bg-[#f6f7f8] px-4 py-3 text-base text-[#031525] placeholder:text-slate-500 focus-visible:border-[#0C53A4] focus-visible:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]/25" />
            </div>
            <div>
              <label for="form-phone" class="mb-2 block text-sm font-bold text-[#031525]">Contact phone</label>
              <input type="tel" id="form-phone" name="phone" autocomplete="tel" inputmode="tel" required placeholder="e.g., +880 1700 000000…" class="min-h-[3.25rem] w-full border border-slate-300 bg-[#f6f7f8] px-4 py-3 text-base text-[#031525] placeholder:text-slate-500 focus-visible:border-[#0C53A4] focus-visible:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]/25 tabular-nums" />
            </div>
          </div>

          <div>
            <label for="form-solution" class="mb-2 block text-sm font-bold text-[#031525]">Equipment category</label>
            <select id="form-solution" name="solution" autocomplete="off" class="min-h-[3.25rem] w-full border border-slate-300 bg-[#f6f7f8] px-4 py-3 text-base text-[#031525] focus-visible:border-[#0C53A4] focus-visible:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]/25">
              <option value="Distribution Transformer (100kVA–3000kVA)">Distribution Transformer (100kVA–3000kVA)</option>
              <option value="LT Switchgear & ACB Panels (Up to 6300A)">LT Switchgear &amp; ACB Panels (Up to 6300A)</option>
              <option value="PFI Plant & Power Factor Optimization">PFI Plant &amp; Power Factor Optimization</option>
              <option value="11 kV HT Switchgear (ABB VD4 VCB)">11 kV HT Switchgear (ABB VD4 VCB)</option>
              <option value="Industrial Automation & Control Panels">Industrial Automation &amp; Control Panels</option>
              <option value="Substation AMC & Testing Services">Substation AMC &amp; Testing Services</option>
              <option value="Utility Load Sanction Documentation">Utility Load Sanction Documentation</option>
            </select>
          </div>

          <div>
            <label for="form-details" class="mb-2 block text-sm font-bold text-[#031525]">Project requirements and load specifications</label>
            <textarea id="form-details" name="details" rows="6" autocomplete="off" required placeholder="e.g., Capacity, site location, utility requirements, delivery timeframe, and preferred components…" class="w-full resize-y border border-slate-300 bg-[#f6f7f8] px-4 py-3 text-base text-[#031525] placeholder:text-slate-500 focus-visible:border-[#0C53A4] focus-visible:bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]/25"></textarea>
          </div>

          <button type="submit" class="inline-flex min-h-[3.25rem] w-full items-center justify-center bg-[#0C53A4] px-6 py-3.5 text-base font-bold text-white transition-colors hover:bg-[#084584] focus-visible:ring-2 focus-visible:ring-[#031525] focus-visible:ring-offset-2 sm:w-auto">
            Prepare Email Inquiry <span class="ml-3" aria-hidden="true">→</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-300 bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-5">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[#0C53A4]">Ready-Made Inquiry Formats</p>
          <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">{prefilledInquiries.title}</h2>
        </div>
        <p class="max-w-2xl text-base leading-7 text-slate-600 lg:col-span-6 lg:col-start-7">{prefilledInquiries.description}</p>
      </div>

      <div class="mt-10 grid border-t border-slate-300 md:grid-cols-2">
        {prefilledInquiries.templates.map((template: any, index: number) => (
          <a
            href={`mailto:info@pacificpowertech.com.bd?subject=${encodeURIComponent(template.subject)}&body=${template.body}`}
            class:list={[
              'group border-b border-slate-300 py-7 md:px-8',
              index % 2 === 0 ? 'md:border-r md:pl-0' : 'md:pr-0',
            ]}
          >
            <span class="text-sm font-semibold text-[#0C53A4]">{template.badge}</span>
            <h3 class="mt-2 flex items-start justify-between gap-5 font-heading text-xl font-bold text-[#031525] group-hover:text-[#0C53A4]">
              {template.title}<span class="shrink-0" aria-hidden="true">↗</span>
            </h3>
            <p class="mt-3 max-w-xl text-sm leading-6 text-slate-600">{template.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('direct-inquiry-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const name = (document.getElementById('form-name') as HTMLInputElement)?.value || '';
      const company = (document.getElementById('form-company') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('form-phone') as HTMLInputElement)?.value || '';
      const solution = (document.getElementById('form-solution') as HTMLSelectElement)?.value || '';
      const details = (document.getElementById('form-details') as HTMLTextAreaElement)?.value || '';
      const subject = encodeURIComponent(`Inquiry: ${solution} - ${company}`);
      const body = encodeURIComponent(
        `Dear Pacific Powertech Team,\n\nI would like to request technical specifications and a quotation for the following:\n\nSolution: ${solution}\nCompany: ${company}\nContact Person: ${name}\nPhone: ${phone}\n\nProject Requirements:\n${details}\n\nThank you,\n${name}`
      );
      window.location.href = `mailto:info@pacificpowertech.com.bd?subject=${subject}&body=${body}`;
    });
  }
</script>
