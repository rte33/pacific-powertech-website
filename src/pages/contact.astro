---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContactPage, formatUrl } from '../utils/content';

const contactData = getContactPage();
const { meta, header, office, contactNumbers, emails, businessHours, prefilledInquiries } = contactData;
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Page Header -->
  <section class="bg-[#070707] text-white py-12 sm:py-16 border-b-2 border-[#0C53A4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-2">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#FAB218] font-mono">
          Direct Engineering Inquiry Desk
        </span>
        <h1 class="font-heading text-3xl sm:text-5xl font-bold uppercase tracking-tight text-white leading-none">
          {header.title}
        </h1>
        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-sans pt-2">
          {header.subtitle}
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-14">
    <!-- Contact Details & Direct Form Strip -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Office & Contacts -->
      <div class="lg:col-span-6 space-y-6">
        <div class="bg-white p-6 border border-gray-300 border-t-2 border-t-[#0C53A4] space-y-4">
          <div class="border-b border-gray-200 pb-3">
            <h2 class="font-heading text-xl sm:text-2xl font-bold uppercase text-gray-950">
              {office.name}
            </h2>
            <address class="not-italic text-xs sm:text-sm text-gray-700 leading-relaxed font-sans mt-1">
              {office.addressLine1}<br />
              {office.addressLine2}, {office.country}
            </address>
            <a
              href={office.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-xs font-bold uppercase tracking-wider text-[#0C53A4] hover:underline mt-2"
            >
              Open in Google Maps &rarr;
            </a>
          </div>

          <!-- Business Hours -->
          <div class="text-xs text-gray-700 font-sans space-y-1">
            <p><strong class="text-gray-950">Working Hours:</strong> {businessHours.weekdays}</p>
            <p><strong class="text-gray-950">Weekend:</strong> {businessHours.weekend}</p>
            <p class="text-[#0C53A4] font-semibold mt-1">{businessHours.emergencyNote}</p>
          </div>
        </div>

        <!-- Phone & Email Channels -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {contactNumbers.map((num: any) => (
            <div class="bg-white p-4 border border-gray-300 border-l-2 border-l-[#FAB218]">
              <span class="text-[11px] font-mono uppercase text-gray-500 block">{num.label}</span>
              <a href={num.telLink} class="font-heading text-lg font-bold text-gray-950 hover:text-[#0C53A4] block mt-0.5 tabular-nums">
                {num.phone}
              </a>
              {num.description && (
                <p class="text-[11px] text-gray-600 mt-1 font-sans">{num.description}</p>
              )}
            </div>
          ))}

          {emails.map((em: any) => (
            <div class="bg-white p-4 border border-gray-300 border-l-2 border-l-[#0C53A4] sm:col-span-2">
              <span class="text-[11px] font-mono uppercase text-gray-500 block">{em.label}</span>
              <a href={em.mailtoLink} class="font-heading text-lg font-bold text-gray-950 hover:text-[#0C53A4] block mt-0.5">
                {em.email}
              </a>
              {em.description && (
                <p class="text-[11px] text-gray-600 mt-1 font-sans">{em.description}</p>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Right Column: Interactive Quotation Dispatcher -->
      <div class="lg:col-span-6 bg-white p-6 sm:p-8 border border-gray-300 border-t-2 border-t-[#0C53A4]">
        <div class="border-b border-gray-200 pb-3 mb-4">
          <h2 class="font-heading text-xl sm:text-2xl font-bold uppercase text-gray-950">
            Direct Technical Inquiry Form
          </h2>
          <p class="text-xs text-gray-600 font-sans mt-0.5">
            Generates a formatted engineering request directly addressed to <code class="font-mono text-[#0C53A4]">info@pacificpowertech.com.bd</code>.
          </p>
        </div>

        <form id="direct-inquiry-form" class="space-y-3 font-sans">
          <div>
            <label for="form-name" class="block text-xs font-semibold text-gray-800 mb-1">Full Name &amp; Designation *</label>
            <input
              type="text"
              id="form-name"
              required
              placeholder="e.g. Engr. Kabir Hossain, General Manager"
              class="w-full px-3 py-2 text-xs border border-gray-400 rounded-none focus:outline-none focus:ring-2 focus:ring-[#0C53A4] focus:border-[#0C53A4]"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="form-company" class="block text-xs font-semibold text-gray-800 mb-1">Company / Plant Name *</label>
              <input
                type="text"
                id="form-company"
                required
                placeholder="e.g. Apex Textile Mills Ltd."
                class="w-full px-3 py-2 text-xs border border-gray-400 rounded-none focus:outline-none focus:ring-2 focus:ring-[#0C53A4] focus:border-[#0C53A4]"
              />
            </div>
            <div>
              <label for="form-phone" class="block text-xs font-semibold text-gray-800 mb-1">Contact Phone *</label>
              <input
                type="tel"
                id="form-phone"
                required
                placeholder="e.g. +880 1700 000000"
                class="w-full px-3 py-2 text-xs border border-gray-400 rounded-none focus:outline-none focus:ring-2 focus:ring-[#0C53A4] focus:border-[#0C53A4] tabular-nums"
              />
            </div>
          </div>

          <div>
            <label for="form-solution" class="block text-xs font-semibold text-gray-800 mb-1">Equipment Category *</label>
            <select
              id="form-solution"
              class="w-full px-3 py-2 text-xs border border-gray-400 rounded-none focus:outline-none focus:ring-2 focus:ring-[#0C53A4] focus:border-[#0C53A4]"
            >
              <option value="Distribution Transformer (100kVA–3000kVA)">Distribution Transformer (100kVA–3000kVA)</option>
              <option value="LT Switchgear & ACB Panels (Up to 6300A)">LT Switchgear & ACB Panels (Up to 6300A)</option>
              <option value="PFI Plant & Power Factor Optimization">PFI Plant & Power Factor Optimization</option>
              <option value="11 kV HT Switchgear (ABB VD4 VCB)">11 kV HT Switchgear (ABB VD4 VCB)</option>
              <option value="Industrial Automation & Control Panels">Industrial Automation & Control Panels</option>
              <option value="Substation AMC & Testing Services">Substation AMC & Testing Services</option>
              <option value="Utility Load Sanction Documentation">Utility Load Sanction Documentation</option>
            </select>
          </div>

          <div>
            <label for="form-details" class="block text-xs font-semibold text-gray-800 mb-1">Project Requirements / Load Specs *</label>
            <textarea
              id="form-details"
              rows="3"
              required
              placeholder="State capacity (kVA/Amps), delivery timeframe, or utility guideline..."
              class="w-full px-3 py-2 text-xs border border-gray-400 rounded-none focus:outline-none focus:ring-2 focus:ring-[#0C53A4] focus:border-[#0C53A4]"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3 px-4 text-xs font-bold uppercase tracking-wider rounded-none bg-[#0C53A4] text-white hover:bg-[#213C94] transition-colors shadow-xs focus:ring-2 focus:ring-[#0C53A4]"
          >
            Email Inquiry to Engineering &rarr;
          </button>
        </form>
      </div>
    </div>

    <!-- Quick Prefilled Email Quotation Links -->
    <section class="border-t border-gray-300 pt-8">
      <div class="border-b border-gray-200 pb-2 mb-6">
        <h2 class="font-heading text-xl sm:text-2xl font-bold uppercase text-gray-950">
          {prefilledInquiries.title}
        </h2>
        <p class="text-xs text-gray-600 font-sans mt-0.5">
          {prefilledInquiries.description}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {prefilledInquiries.templates.map((tpl: any) => (
          <div class="bg-white p-5 border border-gray-300 flex flex-col justify-between space-y-3">
            <div>
              <span class="font-mono text-[10px] uppercase font-bold text-[#0C53A4] block">
                {tpl.badge}
              </span>
              <h3 class="font-heading text-base font-bold uppercase text-gray-950 mt-1 mb-1">{tpl.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed font-sans">{tpl.summary}</p>
            </div>
            <a
              href={`mailto:info@pacificpowertech.com.bd?subject=${encodeURIComponent(tpl.subject)}&body=${tpl.body}`}
              class="inline-block text-xs font-bold uppercase tracking-wider text-[#D81A21] hover:underline pt-2 border-t border-gray-100 font-sans"
            >
              Open Email Template &rarr;
            </a>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('direct-inquiry-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('form-name') as HTMLInputElement)?.value || '';
      const company = (document.getElementById('form-company') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('form-phone') as HTMLInputElement)?.value || '';
      const solution = (document.getElementById('form-solution') as HTMLSelectElement)?.value || '';
      const details = (document.getElementById('form-details') as HTMLTextAreaElement)?.value || '';

      const subject = encodeURIComponent(`Inquiry: ${solution} - ${company}`);
      const body = encodeURIComponent(
        `Dear Pacific Powertech Team,\n\nI would like to request technical specifications and a quotation for the following:\n\nSolution: ${solution}\nCompany: ${company}\nContact Person: ${name}\nPhone: ${phone}\n\nProject Requirements:\n${details}\n\nThank you,\n${name}`
      );

      window.location.href = `mailto:info@pacificpowertech.com.bd?subject=${subject}&body=${body}`;
    });
  }
</script>
