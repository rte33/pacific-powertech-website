---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getContactPage, formatUrl } from '../utils/content';

const contactData = getContactPage();
const { meta, header, office, contactNumbers, emails, businessHours, prefilledInquiries } = contactData;
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Page Header -->
  <section class="bg-slate-900 text-white py-14 sm:py-20 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-amber-400 mb-3">
          {header.badge}
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white">
          {header.title}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed">
          {header.subtitle}
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <!-- Contact Details & Office Map Info -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Office & Contacts -->
      <div class="lg:col-span-6 space-y-8">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-4">
            Works & Corporate Office
          </h2>
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded bg-blue-50 text-pptl-blue flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <strong class="text-sm font-bold text-slate-900 block">{office.name}</strong>
                <address class="not-italic text-sm text-slate-600 leading-relaxed mt-1">
                  {office.addressLine1}<br />
                  {office.addressLine2}, {office.country}
                </address>
                <a
                  href={office.googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center text-xs font-semibold text-pptl-blue hover:underline mt-2"
                >
                  View on Google Maps &rarr;
                </a>
              </div>
            </div>

            <!-- Business Hours -->
            <div class="pt-4 border-t border-slate-100 flex items-start gap-3">
              <div class="w-8 h-8 rounded bg-amber-50 text-amber-600 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="text-xs text-slate-600">
                <p><strong class="text-slate-900">Working Days:</strong> {businessHours.weekdays}</p>
                <p><strong class="text-slate-900">Weekend:</strong> {businessHours.weekend}</p>
                <p class="text-pptl-blue font-medium mt-1">{businessHours.emergencyNote}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Phone & Email Channels -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {contactNumbers.map((num: any) => (
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs">
              <span class="text-xs font-semibold text-slate-500 block">{num.label}</span>
              <a href={num.telLink} class="text-base font-bold text-pptl-blue hover:underline block mt-1">
                {num.phone}
              </a>
              {num.description && (
                <p class="text-xs text-slate-500 mt-1">{num.description}</p>
              )}
            </div>
          ))}

          {emails.map((em: any) => (
            <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-xs sm:col-span-2">
              <span class="text-xs font-semibold text-slate-500 block">{em.label}</span>
              <a href={em.mailtoLink} class="text-base font-bold text-pptl-blue hover:underline block mt-1">
                {em.email}
              </a>
              {em.description && (
                <p class="text-xs text-slate-500 mt-1">{em.description}</p>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Interactive Inquiry Dispatcher -->
      <div class="lg:col-span-6 bg-white p-8 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-xl font-bold text-slate-900 mb-2">Direct Inquiry Form</h2>
          <p class="text-xs text-slate-600 mb-6">
            Complete the details below to generate a formatted technical request addressed to <code>info@pacificpowertech.com.bd</code>.
          </p>

          <form id="direct-inquiry-form" class="space-y-4">
            <div>
              <label for="form-name" class="block text-xs font-semibold text-slate-700 mb-1">Full Name &amp; Designation *</label>
              <input
                type="text"
                id="form-name"
                required
                placeholder="e.g. Engr. Kabir Hossain, General Manager"
                class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-pptl-blue focus:border-pptl-blue"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="form-company" class="block text-xs font-semibold text-slate-700 mb-1">Company / Facility Name *</label>
                <input
                  type="text"
                  id="form-company"
                  required
                  placeholder="e.g. Apex Textile Mills Ltd."
                  class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-pptl-blue focus:border-pptl-blue"
                />
              </div>
              <div>
                <label for="form-phone" class="block text-xs font-semibold text-slate-700 mb-1">Contact Phone *</label>
                <input
                  type="tel"
                  id="form-phone"
                  required
                  placeholder="e.g. +880 1700 000000"
                  class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-pptl-blue focus:border-pptl-blue"
                />
              </div>
            </div>

            <div>
              <label for="form-solution" class="block text-xs font-semibold text-slate-700 mb-1">Solution / Equipment Category *</label>
              <select
                id="form-solution"
                class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-pptl-blue focus:border-pptl-blue"
              >
                <option value="Distribution Transformer (100kVA–3000kVA)">Distribution Transformer (100kVA–3000kVA)</option>
                <option value="LT Switchgear & ACB Panels (Up to 6300A)">LT Switchgear & ACB Panels (Up to 6300A)</option>
                <option value="PFI Plant & Power Factor Optimization">PFI Plant & Power Factor Optimization</option>
                <option value="11 kV HT Switchgear (ABB VD4 VCB)">11 kV HT Switchgear (ABB VD4 VCB)</option>
                <option value="Industrial Automation & Control Panels">Industrial Automation & Control Panels</option>
                <option value="Substation AMC & Emergency Testing">Substation AMC & Emergency Testing</option>
                <option value="Utility Load Sanction Documentation">Utility Load Sanction Documentation</option>
              </select>
            </div>

            <div>
              <label for="form-details" class="block text-xs font-semibold text-slate-700 mb-1">Project Requirements / Load Specs *</label>
              <textarea
                id="form-details"
                rows="4"
                required
                placeholder="Mention required rating (kVA/Amps), site location, delivery timeline, or specific utility standard..."
                class="w-full px-3 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-pptl-blue focus:border-pptl-blue"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 text-sm font-bold rounded-md bg-pptl-blue text-white hover:bg-blue-800 transition-colors shadow-sm focus:ring-2 focus:ring-offset-2 focus:ring-blue-600"
            >
              Compose Official Email Inquiry &rarr;
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Quick Prefilled Email Quotation Links -->
    <section class="border-t border-slate-200 pt-12">
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">
          {prefilledInquiries.title}
        </h2>
        <p class="text-sm text-slate-600 mt-1">
          {prefilledInquiries.description}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {prefilledInquiries.templates.map((tpl: any) => (
          <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-pptl-blue bg-blue-50 px-2 py-0.5 rounded mb-2">
                {tpl.badge}
              </span>
              <h3 class="text-base font-bold text-slate-900 mb-1">{tpl.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">{tpl.summary}</p>
            </div>
            <a
              href={`mailto:info@pacificpowertech.com.bd?subject=${encodeURIComponent(tpl.subject)}&body=${tpl.body}`}
              class="inline-flex items-center text-xs font-bold text-pptl-red hover:underline pt-3 border-t border-slate-100"
            >
              Open Prefilled Email Template &rarr;
            </a>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('direct-inquiry-form') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('form-name') as HTMLInputElement)?.value || '';
      const company = (document.getElementById('form-company') as HTMLInputElement)?.value || '';
      const phone = (document.getElementById('form-phone') as HTMLInputElement)?.value || '';
      const solution = (document.getElementById('form-solution') as HTMLSelectElement)?.value || '';
      const details = (document.getElementById('form-details') as HTMLTextAreaElement)?.value || '';

      const subject = encodeURIComponent(`Inquiry: ${solution} - ${company}`);
      const body = encodeURIComponent(
        `Dear Pacific Powertech Team,\n\nI would like to request technical specifications and a quotation for the following:\n\nSolution: ${solution}\nCompany: ${company}\nContact Person: ${name}\nPhone: ${phone}\n\nProject Requirements:\n${details}\n\nThank you,\n${name}`
      );

      window.location.href = `mailto:info@pacificpowertech.com.bd?subject=${subject}&body=${body}`;
    });
  }
</script>

