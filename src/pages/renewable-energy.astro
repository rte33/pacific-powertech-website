---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRenewableEnergyPage, formatUrl } from '../utils/content';
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';
import CatalogDownloadBanner from '../components/CatalogDownloadBanner.astro';

const data = getRenewableEnergyPage();
const { meta, header, solutions, advantages, workflow, gallery, faqs, cta } = data;

const heroImage = await resolveImage(header.heroImage);

const solutionsWithImages = await Promise.all(
  solutions.items.map(async (item: any) => ({
    ...item,
    imgMeta: item.image ? await resolveImage(item.image) : null,
  }))
);

const galleryWithImages = await Promise.all(
  gallery.images.map(async (item: any) => ({
    ...item,
    imgMeta: item.image ? await resolveImage(item.image) : null,
  }))
);
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Hero Section -->
  <section class="overflow-hidden border-b border-slate-300 bg-[#eef1f3]">
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 sm:pb-20 lg:px-8">
      <nav class="text-sm text-slate-600" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href={formatUrl('/')} class="hover:text-[#0C53A4]">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-[#031525]">Renewable Energy</li>
        </ol>
      </nav>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#0C53A4]">
            {header.badge} · SREDA Certified Net Metering
          </p>
          <h1 class="mt-5 max-w-4xl font-heading text-[clamp(2.6rem,5.5vw,5.2rem)] font-bold leading-[0.96] tracking-[-0.05em] text-[#031525]">
            {header.title}
          </h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">
            {header.subtitle}
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a
              href={formatUrl('/contact')}
              class="inline-flex min-h-12 items-center bg-[#0C53A4] px-6 font-bold text-white transition-colors hover:bg-[#084584]"
            >
              Request Feasibility Study <span class="ml-3" aria-hidden="true">&rarr;</span>
            </a>
            <a
              href="tel:+8801303075003"
              class="inline-flex min-h-12 items-center border-b-2 border-[#031525] px-1 font-bold text-[#031525] hover:border-[#0C53A4] hover:text-[#0C53A4]"
            >
              Call Solar Desk: +880 1303 075 003
            </a>
          </div>
        </div>

        <div class="relative lg:col-span-5">
          {heroImage && (
            <div class="border border-slate-300 bg-white p-2 shadow-sm">
              <Image
                src={heroImage}
                alt="Industrial rooftop solar PV panel installation by Pacific Powertech"
                class="aspect-[4/3] w-full object-cover"
                widths={[480, 720, 960]}
                loading="eager"
              />
              <div class="bg-[#031525] p-4 text-white">
                <span class="block text-xs font-bold uppercase tracking-[0.16em] text-[#FAB218]">
                  Clean Power Generation
                </span>
                <p class="mt-1 text-sm font-semibold">
                  Turnkey C&amp;I Solar PV &bull; Grid Synchronized EPC
                </p>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Quick Stats Strip -->
    <div class="border-t border-slate-300 bg-white">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 divide-x divide-y divide-slate-200 sm:grid-cols-4 sm:divide-y-0">
          {header.stats.map((stat: any) => (
            <div class="py-6 px-4 first:pl-0 last:pr-0">
              <span class="block font-heading text-3xl font-bold tracking-tight text-[#0C53A4] sm:text-4xl tabular-nums">
                {stat.value}
              </span>
              <span class="mt-1 block text-sm font-bold uppercase tracking-wider text-[#031525]">
                {stat.label}
              </span>
              <span class="mt-0.5 block text-xs leading-5 text-slate-500">
                {stat.subtext}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Core Solar Solutions Section -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mb-12 border-b border-slate-300 pb-6">
      <span class="block text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">
        Renewable Engineering Architecture
      </span>
      <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">
        {solutions.title}
      </h2>
      <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
        {solutions.subtitle}
      </p>
    </div>

    <div class="space-y-16">
      {solutionsWithImages.map((sol, index) => {
        const isReversed = index % 2 !== 0;
        return (
          <article class="border-b border-slate-300 pb-16 last:border-b-0 last:pb-0">
            <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
              <!-- Image Column -->
              <div class={`lg:col-span-5 ${isReversed ? 'lg:order-2' : ''}`}>
                <div class="border border-slate-300 bg-white p-2 shadow-sm">
                  {sol.imgMeta ? (
                    <Image
                      src={sol.imgMeta}
                      alt={sol.title}
                      class="aspect-[4/3] w-full object-cover"
                      widths={[360, 540, 720]}
                    />
                  ) : (
                    <div class="flex aspect-[4/3] w-full items-center justify-center bg-slate-100 text-sm text-slate-500">
                      Technical schematic
                    </div>
                  )}
                  <div class="bg-[#f8fafc] px-3 py-2 border-t border-slate-200">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-600">
                      Pacific Powertech Field Engineering
                    </span>
                  </div>
                </div>
              </div>

              <!-- Content Column -->
              <div class={`space-y-4 lg:col-span-7 ${isReversed ? 'lg:order-1' : ''}`}>
                <span class="inline-block border-b-2 border-[#0C53A4] pb-1 text-xs font-bold uppercase tracking-[0.18em] text-[#0C53A4]">
                  {sol.badge}
                </span>

                <h3 class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">
                  {sol.title}
                </h3>

                <p class="text-base leading-7 text-slate-600">
                  {sol.summary}
                </p>

                {sol.highlights && sol.highlights.length > 0 && (
                  <div class="grid grid-cols-1 gap-2.5 border-t border-slate-200 pt-4 sm:grid-cols-2">
                    {sol.highlights.map((item: string) => (
                      <div class="flex items-start gap-2 text-sm leading-6 text-slate-700">
                        <span class="font-bold text-[#0C53A4]">&check;</span>
                        <span>{item}</span>
                      </div>
                    ))}
                  </div>
                )}

                <div class="pt-4">
                  <a
                    href={formatUrl('/contact')}
                    class="inline-flex min-h-11 items-center bg-[#0C53A4] px-5 text-sm font-bold text-white transition-colors hover:bg-[#084584]"
                  >
                    Inquire About This Solution <span class="ml-2" aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Engineering Advantages (Dark Industrial Band) -->
  <section class="border-y border-white/10 bg-[#031525] py-16 text-white sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 border-b border-white/15 pb-6">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#FAB218]">
          Pedigree &bull; Quality Assurance
        </span>
        <h2 class="mt-2 font-heading text-2xl font-bold tracking-tight text-white sm:text-3xl">
          {advantages.title}
        </h2>
        <p class="mt-3 max-w-3xl text-base leading-7 text-slate-300">
          {advantages.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        {advantages.items.map((item: any) => (
          <div class="border-l-2 border-white/25 py-2 pl-5 transition-colors hover:border-[#FAB218]">
            <h3 class="font-heading text-lg font-bold text-white">
              {item.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-slate-300">
              {item.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Turnkey Project Workflow -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="mb-12 border-b border-slate-300 pb-6">
      <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">
        Lifecycle Delivery
      </span>
      <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">
        {workflow.title}
      </h2>
      <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
        {workflow.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {workflow.steps.map((step: any) => (
        <div class="border-t-2 border-[#0C53A4] pt-5">
          <span class="font-heading text-2xl font-bold text-[#0C53A4] tabular-nums">
            {step.number}
          </span>
          <h3 class="mt-2 font-heading text-lg font-bold text-[#031525]">
            {step.title}
          </h3>
          <p class="mt-2.5 text-sm leading-6 text-slate-600">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Real Field Installations Gallery -->
  <section class="border-t border-slate-300 bg-[#f8fafc] py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 border-b border-slate-300 pb-5">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">
          Project Showcase &bull; Actual Installations
        </span>
        <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">
          {gallery.title}
        </h2>
        <p class="mt-3 max-w-3xl text-base leading-7 text-slate-600">
          {gallery.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {galleryWithImages.map((item) => (
          <div class="group overflow-hidden border border-slate-300 bg-white shadow-sm transition-all hover:border-[#0C53A4] hover:shadow-md">
            <div class="aspect-[4/3] overflow-hidden bg-slate-100">
              {item.imgMeta && (
                <Image
                  src={item.imgMeta}
                  alt={item.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  widths={[320, 480, 640]}
                />
              )}
            </div>
            <div class="p-4">
              <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-[#0C53A4]">
                {item.category}
              </span>
              <h3 class="mt-1 font-heading text-sm font-bold text-[#031525] line-clamp-2">
                {item.title}
              </h3>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Technical FAQs -->
  {faqs && faqs.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mb-10 border-b border-slate-300 pb-5">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">
          Technical Knowledge Base
        </span>
        <h2 class="mt-2 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">
          Frequently Asked Questions on Industrial Solar
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {faqs.map((faq: any) => (
          <div class="border-l-4 border-[#0C53A4] bg-white p-6 shadow-sm border border-slate-200">
            <h3 class="font-heading text-lg font-bold text-[#031525]">
              {faq.question}
            </h3>
            <p class="mt-3 text-sm leading-7 text-slate-600">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Action Callout Banner -->
  <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 border-l-4 border-[#FAB218] bg-[#031525] p-8 text-white md:grid-cols-[1fr_auto] md:items-center md:p-10">
      <div>
        <span class="text-xs font-bold uppercase tracking-[0.18em] text-[#FAB218]">
          Turnkey Solar Engineering
        </span>
        <h2 class="mt-2 font-heading text-2xl font-bold tracking-tight sm:text-3xl">
          {cta.title}
        </h2>
        <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-300">
          {cta.description}
        </p>
      </div>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={formatUrl(cta.inquiryUrl)}
          class="inline-flex min-h-12 items-center justify-center bg-[#0C53A4] px-6 text-sm font-bold text-white transition-colors hover:bg-[#084584]"
        >
          {cta.buttonText} &rarr;
        </a>
        <a
          href={`tel:${cta.phone.replace(/\s+/g, '')}`}
          class="inline-flex min-h-12 items-center justify-center border-2 border-white/40 px-5 text-sm font-bold text-white transition-colors hover:border-white hover:bg-white/10"
        >
          Call: {cta.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Official Catalog Download Banner -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <CatalogDownloadBanner />
  </div>
</BaseLayout>
