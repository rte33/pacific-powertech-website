---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutPage, formatUrl } from '../utils/content';
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';
import CatalogDownloadBanner from '../components/CatalogDownloadBanner.astro';

const aboutData = getAboutPage();
const { meta, header, story, visionMission, infrastructure, complianceStandards, teamValues } = aboutData;
const mastheadImage = await resolveImage('substation-switchgear-control-room-lineup.jpeg');
const facilitiesWithImages = await Promise.all(
  infrastructure.facilities.map(async (facility: any) => ({
    ...facility,
    imgMeta: facility.image ? await resolveImage(facility.image) : null,
  }))
);
---

<BaseLayout title={meta.title} description={meta.description}>
  <section class="overflow-hidden border-b border-slate-300 bg-[#eef1f3]">
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 sm:pb-20 lg:px-8">
      <nav class="text-sm text-slate-600" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2"><li><a href={formatUrl('/')} class="hover:text-[#0C53A4]">Home</a></li><li aria-hidden="true">/</li><li aria-current="page" class="text-[#031525]">About Us</li></ol>
      </nav>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#0C53A4]">{header.badge} · Established 2013</p>
          <h1 class="mt-5 max-w-4xl font-heading text-[clamp(2.8rem,6vw,5.8rem)] font-bold leading-[0.95] tracking-[-0.055em] text-[#031525]">{header.title}</h1>
          <p class="mt-7 max-w-2xl text-lg leading-8 text-slate-600">{header.subtitle}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={formatUrl('/contact')} class="inline-flex min-h-12 items-center bg-[#0C53A4] px-6 font-bold text-white transition-colors hover:bg-[#084584]">Visit Our Works <span class="ml-3" aria-hidden="true">→</span></a>
            <a href={formatUrl('/products')} class="inline-flex min-h-12 items-center border-b-2 border-[#031525] px-1 font-bold text-[#031525] hover:border-[#0C53A4] hover:text-[#0C53A4]">Explore Solutions</a>
          </div>
        </div>

        <div class="relative lg:col-span-5 lg:pl-8">
          {mastheadImage && <Image src={mastheadImage} alt="Pacific Powertech substation engineering facility" class="aspect-[4/5] w-full object-cover" widths={[480, 720, 960]} loading="eager" />}
          <div class="absolute -bottom-6 left-0 bg-[#FAB218] px-5 py-4 text-[#031525] lg:left-1">
            <span class="block font-heading text-4xl font-bold leading-none tabular-nums">2013</span>
            <span class="mt-1 block text-xs font-bold uppercase tracking-[0.16em]">Founded in Dhaka</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 sm:py-20 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-4">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">Company Profile</p>
      <h2 class="mt-3 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">{story.title}</h2>
    </div>
    <div class="space-y-5 text-base leading-8 text-slate-700 lg:col-span-7 lg:col-start-6">
      {story.paragraphs.map((paragraph: string, index: number) => (
        <p class:list={[index === 0 && 'text-xl font-semibold leading-8 text-[#031525]']}>{paragraph}</p>
      ))}
      <dl class="mt-10 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-slate-300 pt-7 sm:grid-cols-3">
        <div><dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-600">Team</dt><dd class="mt-1 font-heading text-2xl font-bold text-[#031525]">23 specialists</dd></div>
        <div><dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-600">Testing</dt><dd class="mt-1 font-heading text-2xl font-bold text-[#031525]">BSTI &amp; BUET</dd></div>
        <div><dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-600">Standards</dt><dd class="mt-1 font-heading text-2xl font-bold text-[#031525]">IEC · BS · ANSI</dd></div>
      </dl>
    </div>
  </section>

  <section class="border-y border-slate-300 bg-white">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-2">
      <article class="px-4 py-14 sm:px-6 lg:border-r lg:border-slate-300 lg:px-12 lg:py-20">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">Strategic Direction</p>
        <h2 class="mt-3 font-heading text-3xl font-bold text-[#031525]">{visionMission.vision.title}</h2>
        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">{visionMission.vision.statement}</p>
      </article>
      <article class="bg-[#031525] px-4 py-14 text-white sm:px-6 lg:px-12 lg:py-20">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#FAB218]">Engineering Commitment</p>
        <h2 class="mt-3 font-heading text-3xl font-bold">{visionMission.mission.title}</h2>
        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-300">{visionMission.mission.statement}</p>
      </article>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-5">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">Factory Capabilities</p>
        <h2 class="mt-3 font-heading text-3xl font-bold tracking-tight text-[#031525] sm:text-4xl">{infrastructure.title}</h2>
      </div>
      <p class="text-base leading-7 text-slate-600 lg:col-span-6 lg:col-start-7">{infrastructure.subtitle}</p>
    </div>
    <div class="mt-12 grid gap-10 md:grid-cols-3">
      {facilitiesWithImages.map((facility, index) => (
        <article class:list={['border-t-2 pt-5', index === 1 ? 'border-[#FAB218] md:mt-12' : 'border-[#0C53A4]']}>
          {facility.imgMeta && <Image src={facility.imgMeta} alt={facility.title} class="aspect-[4/3] w-full object-cover" widths={[320, 480, 640]} />}
          <h3 class="mt-5 font-heading text-xl font-bold text-[#031525]">{facility.title}</h3>
          <p class="mt-3 text-sm leading-7 text-slate-600">{facility.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-[#031525] py-16 text-white sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-4">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#FAB218]">Code Compliance</p>
        <h2 class="mt-3 font-heading text-3xl font-bold sm:text-4xl">{complianceStandards.title}</h2>
      </div>
      <div class="divide-y divide-white/15 border-y border-white/15 lg:col-span-7 lg:col-start-6">
        {complianceStandards.items.map((item: any) => (
          <article class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <h3 class="font-heading font-bold text-[#FAB218]">{item.code}</h3>
            <p class="text-sm leading-6 text-slate-300">{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">How We Work</p>
    <h2 class="mt-3 font-heading text-3xl font-bold text-[#031525] sm:text-4xl">{teamValues.title}</h2>
    <div class="mt-10 grid gap-8 md:grid-cols-3">
      {teamValues.values.map((value: any) => (
        <article class="border-t border-slate-400 pt-5"><h3 class="font-heading text-xl font-bold text-[#031525]">{value.name}</h3><p class="mt-3 text-sm leading-7 text-slate-600">{value.description}</p></article>
      ))}
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><CatalogDownloadBanner /></div>
</BaseLayout>
