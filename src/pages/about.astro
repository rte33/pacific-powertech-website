---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutPage, formatUrl } from '../utils/content';
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';
import CatalogDownloadBanner from '../components/CatalogDownloadBanner.astro';

const aboutData = getAboutPage();
const { meta, header, story, visionMission, infrastructure, complianceStandards, teamValues } = aboutData;

// Resolve facility images dynamically
const facilitiesWithImages = await Promise.all(
  infrastructure.facilities.map(async (fac: any) => {
    const imgMeta = fac.image ? await resolveImage(fac.image) : null;
    return { ...fac, imgMeta };
  })
);
---

<BaseLayout title={meta.title} description={meta.description}>
  <!-- Page Header -->
  <section class="bg-[#070707] text-white py-12 sm:py-16 border-b-2 border-[#0C53A4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-2">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#FAB218] font-mono">
          Corporate Profile &bull; Est. 2013
        </span>
        <h1 class="font-heading text-3xl sm:text-5xl font-bold uppercase tracking-tight text-white leading-none">
          {header.title}
        </h1>
        <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-sans pt-2">
          {header.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Corporate Story & Operational Model -->
  <section class="py-12 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <div class="lg:col-span-7 space-y-4">
        <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950">
          {story.title}
        </h2>
        {story.paragraphs.map((p: string) => (
          <p class="text-gray-700 leading-relaxed text-xs sm:text-sm font-sans">
            {p}
          </p>
        ))}

        <div class="pt-3 flex flex-wrap gap-3">
          <a
            href={formatUrl('/contact')}
            class="px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-none bg-[#0C53A4] text-white hover:bg-[#213C94] transition-colors"
          >
            Visit Our Factory &amp; Works &rarr;
          </a>
          <a
            href={formatUrl('/products')}
            class="px-5 py-2.5 text-xs font-semibold uppercase tracking-wider rounded-none border border-gray-400 text-gray-800 hover:bg-gray-100 transition-colors"
          >
            Explore Product Range
          </a>
        </div>
      </div>

      <!-- Quick Facts Panel -->
      <div class="lg:col-span-5 bg-white p-6 border border-gray-300 border-t-2 border-t-[#0C53A4] space-y-4">
        <h3 class="font-heading text-base font-bold uppercase tracking-wider text-gray-900 border-b border-gray-200 pb-2">
          Technical Fact Sheet
        </h3>
        <dl class="space-y-2.5 text-xs divide-y divide-gray-100 font-sans">
          <div class="pt-2 flex justify-between items-center">
            <dt class="font-medium text-gray-600">Establishment:</dt>
            <dd class="font-bold text-gray-950 tabular-nums">2013 (Dhaka, Bangladesh)</dd>
          </div>
          <div class="pt-2 flex justify-between items-center">
            <dt class="font-medium text-gray-600">Active Workforce:</dt>
            <dd class="font-bold text-gray-950 tabular-nums">23 Engineers &amp; Technicians</dd>
          </div>
          <div class="pt-2 flex justify-between items-center">
            <dt class="font-medium text-gray-600">Core Engineering:</dt>
            <dd class="font-bold text-gray-950 text-right">Substations, Switchgear &amp; Automation</dd>
          </div>
          <div class="pt-2 flex justify-between items-center">
            <dt class="font-medium text-gray-600">Laboratory Accreditation:</dt>
            <dd class="font-bold text-gray-950 text-right">BSTI &amp; BUET Approved</dd>
          </div>
          <div class="pt-2 flex justify-between items-center">
            <dt class="font-medium text-gray-600">Design Code Compliance:</dt>
            <dd class="font-bold text-gray-950 text-right">IEC 76, BS, ANSI, VDE, BNBC</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Vision & Mission Strip -->
  <section class="py-10 bg-white border-y border-gray-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Vision -->
        <div class="p-6 border-l-4 border-l-[#0C53A4] bg-[#F6F6F6] border border-gray-200">
          <span class="font-mono text-xs font-bold text-[#0C53A4] uppercase">Strategic Direction</span>
          <h2 class="font-heading text-xl font-bold uppercase text-gray-950 mt-1 mb-2">{visionMission.vision.title}</h2>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans">{visionMission.vision.statement}</p>
        </div>

        <!-- Mission -->
        <div class="p-6 border-l-4 border-l-[#D81A21] bg-[#F6F6F6] border border-gray-200">
          <span class="font-mono text-xs font-bold text-[#D81A21] uppercase">Engineering Commitment</span>
          <h2 class="font-heading text-xl font-bold uppercase text-gray-950 mt-1 mb-2">{visionMission.mission.title}</h2>
          <p class="text-xs sm:text-sm text-gray-700 leading-relaxed font-sans">{visionMission.mission.statement}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing Facilities & Infrastructure -->
  <section class="py-12 sm:py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="border-b border-gray-300 pb-3 mb-8">
      <span class="text-xs font-bold uppercase tracking-widest text-[#0C53A4] font-mono">
        Factory Capabilities
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-gray-950 mt-1">
        {infrastructure.title}
      </h2>
      <p class="text-xs sm:text-sm text-gray-600 mt-0.5 font-sans">
        {infrastructure.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {facilitiesWithImages.map((fac) => (
        <div class="bg-white border border-gray-300 flex flex-col">
          {fac.imgMeta && (
            <div class="aspect-[16/10] bg-gray-100 border-b border-gray-200 overflow-hidden">
              <Image
                src={fac.imgMeta}
                alt={fac.title}
                class="w-full h-full object-cover"
                widths={[320, 480]}
              />
            </div>
          )}
          <div class="p-5 flex-1 flex flex-col justify-between space-y-2">
            <div>
              <h3 class="font-heading text-lg font-bold uppercase text-gray-950 mb-1">{fac.title}</h3>
              <p class="text-xs text-gray-600 leading-relaxed font-sans">{fac.description}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Governance & Standards Strip -->
  <section class="py-12 bg-[#070707] text-white border-t-2 border-[#0C53A4]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="border-b border-gray-800 pb-3 mb-6">
        <span class="text-xs font-bold uppercase tracking-widest text-[#FAB218] font-mono">
          Code Compliance
        </span>
        <h2 class="font-heading text-2xl sm:text-3xl font-bold uppercase tracking-tight text-white mt-1">
          {complianceStandards.title}
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {complianceStandards.items.map((item: any) => (
          <div class="p-4 border-l-2 border-gray-700 bg-gray-900/60">
            <span class="font-heading text-base font-bold text-[#FAB218] block uppercase">{item.code}</span>
            <p class="text-xs text-gray-400 mt-1 leading-relaxed font-sans">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Catalog Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <CatalogDownloadBanner />
  </div>
</BaseLayout>
