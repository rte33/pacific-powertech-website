---
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';
import { formatUrl } from '../utils/content';

interface ProductItem {
  title: string;
  category: string;
  image: string;
  specification: string;
  url: string;
}

interface Props {
  title: string;
  subtitle: string;
  items: ProductItem[];
}

const { title, subtitle, items } = Astro.props;
const railId = `product-rail-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

const products = await Promise.all(
  items.map(async (item) => ({
    ...item,
    imageMeta: await resolveImage(item.image),
  }))
);
---

<section class="border-y border-slate-200 bg-[#edf3f8] py-14 sm:py-20" aria-labelledby={`${railId}-heading`}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-8 flex items-end justify-between gap-6 border-b border-slate-300 pb-5">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#0C53A4]">Product Index · Catalog Range</span>
        <h2 id={`${railId}-heading`} class="mt-2 font-heading text-3xl font-bold leading-tight text-[#07131f] sm:text-4xl">
          {title}
        </h2>
        <p class="mt-2 text-base leading-relaxed text-slate-600">{subtitle}</p>
      </div>

      <div class="hidden shrink-0 gap-2 sm:flex">
        <button
          type="button"
          class="product-rail-prev flex h-12 w-12 items-center justify-center border border-slate-400 bg-white text-xl text-[#07131f] transition-colors hover:border-[#0C53A4] hover:text-[#0C53A4] disabled:cursor-not-allowed disabled:opacity-40"
          aria-label="Scroll products backward"
          aria-controls={railId}
        >
          <span aria-hidden="true">&larr;</span>
        </button>
        <button
          type="button"
          class="product-rail-next flex h-12 w-12 items-center justify-center bg-[#0C53A4] text-xl text-white transition-colors hover:bg-[#084584] disabled:cursor-not-allowed disabled:opacity-40"
          aria-label="Scroll products forward"
          aria-controls={railId}
        >
          <span aria-hidden="true">&rarr;</span>
        </button>
      </div>
    </div>

    <div
      id={railId}
      class="product-rail flex snap-x snap-mandatory gap-5 overflow-x-auto pb-5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]"
      tabindex="0"
      role="region"
      aria-label="Additional products from the Pacific Powertech catalog"
    >
      {products.map((product) => (
        <article class="group w-[82vw] max-w-[340px] shrink-0 snap-start border border-slate-300 bg-white sm:w-[330px]">
          <a href={formatUrl(product.url)} class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#0C53A4]">
            <div class="relative aspect-[4/3] overflow-hidden border-b border-slate-200 bg-slate-100">
              {product.imageMeta ? (
                <Image
                  src={product.imageMeta}
                  alt={product.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  widths={[320, 480, 640]}
                  sizes="(max-width: 640px) 82vw, 340px"
                />
              ) : (
                <div class="flex h-full items-center justify-center text-sm text-slate-500">Image pending</div>
              )}
            </div>
            <div class="min-h-[168px] p-5">
              <span class="text-xs font-bold uppercase tracking-[0.16em] text-[#0C53A4]">{product.category}</span>
              <h3 class="mt-2 font-heading text-xl font-bold leading-tight text-[#07131f] transition-colors group-hover:text-[#0C53A4]">
                {product.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{product.specification}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-[#0C53A4]">
                View related system <span aria-hidden="true">&rarr;</span>
              </span>
            </div>
          </a>
        </article>
      ))}
    </div>

    <p class="mt-2 text-sm text-slate-600 sm:hidden">Swipe horizontally to browse the catalog range.</p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.product-rail').forEach((rail) => {
    const section = rail.closest('section');
    const previous = section?.querySelector<HTMLButtonElement>('.product-rail-prev');
    const next = section?.querySelector<HTMLButtonElement>('.product-rail-next');

    if (!previous || !next) return;

    const updateControls = () => {
      const maxScroll = rail.scrollWidth - rail.clientWidth;
      previous.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft >= maxScroll - 2;
    };

    const scrollRail = (direction: number) => {
      const card = rail.querySelector<HTMLElement>('article');
      const distance = card ? card.offsetWidth + 20 : rail.clientWidth * 0.8;
      rail.scrollBy({
        left: direction * distance,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    };

    previous.addEventListener('click', () => scrollRail(-1));
    next.addEventListener('click', () => scrollRail(1));
    rail.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls);
    updateControls();
  });
</script>
