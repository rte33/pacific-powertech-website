---
import { formatUrl } from '../utils/content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Download the Complete Pacific Powertech Technical Catalog",
  description = "Access complete engineering schematics, power transformer loss tables, switchgear dimensions, and automation panel specifications in our official 20-page reference catalog.",
} = Astro.props;
---

<section class="bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 rounded-2xl my-16 shadow-xl border border-blue-900/50">
  <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="space-y-3 max-w-2xl text-center md:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 text-blue-300 text-xs font-semibold uppercase tracking-wider border border-blue-400/30">
        <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        Authoritative Industrial Reference
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white">
        {title}
      </h2>
      <p class="text-slate-300 text-sm leading-relaxed">
        {description}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row md:flex-col gap-3 w-full md:w-auto flex-shrink-0">
      <a
        href={formatUrl('/assets/PPL Catalog.pdf')}
        download="Pacific-Powertech-Catalog.pdf"
        class="inline-flex items-center justify-center px-6 py-3.5 text-sm font-bold rounded-lg bg-pptl-red text-white hover:bg-red-700 transition-all shadow-md hover:shadow-lg focus:ring-2 focus:ring-offset-2 focus:ring-red-500"
      >
        <svg class="w-5 h-5 mr-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        Download Catalog PDF (1.2 MB)
      </a>

      <a
        href={formatUrl('/contact')}
        class="inline-flex items-center justify-center px-6 py-3 text-sm font-semibold rounded-lg bg-white/10 hover:bg-white/20 text-white border border-white/20 transition-all text-center focus:ring-2 focus:ring-white"
      >
        Contact Our Engineers
      </a>
    </div>
  </div>
</section>

