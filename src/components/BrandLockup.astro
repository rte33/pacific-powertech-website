---
import { Image } from 'astro:assets';
import { getSiteSettings } from '../utils/content';
import { resolveImage } from '../utils/assets';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const site = getSiteSettings();
const icon = await resolveImage(site.company.branding.logoIcon);
---

<span class="brand-lockup inline-flex min-w-0 items-center gap-1.5 min-[360px]:gap-2 sm:gap-3" translate="no">
  {icon && (
    <span class:list={['brand-lockup__mark relative shrink-0 overflow-hidden rounded-full', compact ? 'h-8 w-8 min-[360px]:h-9 min-[360px]:w-9 sm:h-10 sm:w-10' : 'h-12 w-12 sm:h-14 sm:w-14']} aria-hidden="true">
      <Image src={icon} alt="" class="absolute inset-0 h-full w-full scale-[1.18] object-cover" loading="eager" />
    </span>
  )}
  <span class="min-w-0 leading-none">
    <span class:list={['block whitespace-nowrap font-heading font-bold uppercase tracking-[-0.04em] text-white', compact ? 'text-[0.78rem] min-[360px]:text-[0.88rem] sm:text-xl' : 'text-lg sm:text-[1.55rem]']}>
      Pacific Powertech Ltd.
    </span>
    <span class:list={['mt-1 block whitespace-nowrap font-sans font-semibold tracking-[0.14em] text-white', compact ? 'text-[0.5rem] min-[360px]:text-[0.58rem] sm:text-[0.68rem]' : 'text-[0.62rem] sm:text-xs']}>
      Excellence in Energy
    </span>
  </span>
</span>

<style>
  .brand-lockup__mark {
    clip-path: circle(43% at 50% 50%);
  }
</style>
