---
import { getSiteSettings, formatUrl } from '../utils/content';
import BrandLockup from './BrandLockup.astro';

interface Props {
  currentPath?: string;
  variant?: 'default' | 'overlay';
}

const { currentPath = '/', variant = 'default' } = Astro.props;
const site = getSiteSettings();
const navItems = site.navigation;
const isOverlay = variant === 'overlay';
const basePath = formatUrl('/').replace(/\/$/, '');
const normalizedPath = basePath && currentPath.startsWith(basePath)
  ? currentPath.slice(basePath.length) || '/'
  : currentPath;
---

<header
  class:list={[
    'top-0 z-50 w-full border-b border-white/15 text-white',
    isOverlay ? 'absolute bg-[#031525]/[0.68] backdrop-blur-[3px]' : 'sticky bg-[#031525]',
  ]}
  data-header-variant={variant}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between gap-2 min-[360px]:gap-5 sm:h-24">
      <a
        href={formatUrl('/')}
        class="min-w-0 shrink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FAB218]"
        aria-label="Pacific Powertech home"
      >
        <BrandLockup compact />
      </a>

      <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Main Navigation">
        {navItems.map((item: any) => {
          const isActive = normalizedPath === item.path || (item.path !== '/' && normalizedPath.startsWith(item.path));
          if (item.children?.length) {
            return (
              <div class="group relative">
                <a
                  href={formatUrl(item.path)}
                  class:list={[
                    'inline-flex min-h-11 items-center gap-1.5 border-b-2 px-3 py-2 text-sm font-semibold transition-colors',
                    isActive ? 'border-[#FAB218] text-white' : 'border-transparent text-white/80 hover:border-white/40 hover:text-white',
                  ]}
                  aria-haspopup="true"
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.title}
                  <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7" />
                  </svg>
                </a>
                <div class="invisible absolute left-0 top-full z-50 w-80 translate-y-2 border border-slate-200 bg-white p-2 text-[#031525] opacity-0 shadow-xl transition-[opacity,transform] duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                  <a href={formatUrl(item.path)} class="mb-1 flex min-h-11 items-center justify-between border-b border-slate-200 px-3 text-xs font-bold uppercase tracking-[0.12em] text-[#0C53A4] hover:bg-slate-50">
                    <span>View All Solutions</span><span aria-hidden="true">→</span>
                  </a>
                  {item.children.map((sub: any) => (
                    <a href={formatUrl(sub.path)} class="block border-l-2 border-transparent px-3 py-2.5 hover:border-[#0C53A4] hover:bg-slate-50 focus-visible:border-[#0C53A4]">
                      <span class="block text-sm font-bold">{sub.title}</span>
                      {sub.description && <span class="mt-0.5 block text-xs leading-5 text-slate-500">{sub.description}</span>}
                    </a>
                  ))}
                </div>
              </div>
            );
          }

          return (
            <a
              href={formatUrl(item.path)}
              class:list={[
                'inline-flex min-h-11 items-center border-b-2 px-3 py-2 text-sm font-semibold transition-colors',
                isActive ? 'border-[#FAB218] text-white' : 'border-transparent text-white/80 hover:border-white/40 hover:text-white',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.title}
            </a>
          );
        })}
      </nav>

      <div class="hidden shrink-0 items-center sm:flex">
        <a href={formatUrl('/contact')} class="inline-flex min-h-11 items-center gap-3 bg-[#0C53A4] px-5 text-sm font-bold text-white transition-colors hover:bg-[#084584] focus-visible:ring-2 focus-visible:ring-[#FAB218]">
          Request a Quote <span aria-hidden="true">→</span>
        </a>
      </div>

      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex min-h-11 min-w-11 items-center justify-center text-white hover:bg-white/10 focus-visible:ring-2 focus-visible:ring-[#FAB218] lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Toggle navigation menu"
      >
        <svg id="icon-menu" class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg id="icon-close" class="hidden h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden max-h-[calc(100vh-5rem)] overflow-y-auto border-t border-white/15 bg-[#031525] px-4 pb-6 pt-3 lg:hidden">
    <nav class="mx-auto max-w-7xl" aria-label="Mobile navigation">
      {navItems.map((item: any) => {
        const isActive = normalizedPath === item.path || (item.path !== '/' && normalizedPath.startsWith(item.path));
        return (
          <div class="border-b border-white/10 py-1.5">
            <a href={formatUrl(item.path)} class:list={['flex min-h-11 items-center px-3 text-base font-semibold', isActive ? 'text-[#FAB218]' : 'text-white']} aria-current={isActive ? 'page' : undefined}>
              {item.title}
            </a>
            {item.children?.length && (
              <div class="mb-2 border-l border-white/20 pl-3">
                {item.children.map((sub: any) => <a href={formatUrl(sub.path)} class="flex min-h-11 items-center px-3 text-sm text-slate-300 hover:text-white">{sub.title}</a>)}
              </div>
            )}
          </div>
        );
      })}
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        <a href={formatUrl('/assets/PPL Catalog.pdf')} download="Pacific-Powertech-Catalog.pdf" class="inline-flex min-h-11 items-center justify-center border border-white/35 px-4 text-sm font-bold text-white hover:border-white">Download Catalog</a>
        <a href={formatUrl('/contact')} class="inline-flex min-h-11 items-center justify-center bg-[#0C53A4] px-4 text-sm font-bold text-white hover:bg-[#084584]">Request a Quote</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (btn && nav && iconMenu && iconClose) {
    const setMenuOpen = (isOpen: boolean) => {
      btn.setAttribute('aria-expanded', String(isOpen));
      nav.classList.toggle('hidden', !isOpen);
      iconMenu.classList.toggle('hidden', isOpen);
      iconClose.classList.toggle('hidden', !isOpen);
    };
    btn.addEventListener('click', () => setMenuOpen(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        btn.focus();
      }
    });
  }
</script>
