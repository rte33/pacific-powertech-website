---
import { getSiteSettings, formatUrl } from '../utils/content';
import { Image } from 'astro:assets';
import logoStacked from '../assets/images/pacific-powertech-logo-stacked.jpeg';

const site = getSiteSettings();
const company = site.company;
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-300 border-t border-slate-800">
  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Corporate Profile -->
      <div class="space-y-4">
        <div class="bg-white p-2 rounded-md inline-block max-w-[200px]">
          <Image
            src={logoStacked}
            alt={company.name}
            class="h-14 w-auto object-contain"
            height={56}
          />
        </div>
        <p class="text-xs text-slate-400 leading-relaxed">
          {company.tagline}
        </p>
        <div class="pt-2 text-xs text-slate-400">
          <p><strong class="text-slate-200">Established:</strong> {company.established}</p>
          <p><strong class="text-slate-200">Workforce:</strong> {company.employees} Specialized Engineers & Technicians</p>
          <p><strong class="text-slate-200">Standards:</strong> IEC 76, BS, ANSI, VDE, BNBC</p>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">Quick Navigation</h2>
        <ul class="space-y-2 text-sm">
          {site.navigation.map((item: any) => (
            <li>
              <a href={formatUrl(item.path)} class="hover:text-white transition-colors text-slate-300 flex items-center">
                <span class="text-pptl-red mr-1.5">&rsaquo;</span>
                {item.title}
              </a>
            </li>
          ))}
          <li>
            <a href={formatUrl('/assets/PPL Catalog.pdf')} download="Pacific-Powertech-Catalog.pdf" class="hover:text-white transition-colors text-slate-300 flex items-center">
              <span class="text-pptl-red mr-1.5">&rsaquo;</span>
              Download Product Catalog
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Core Engineering Products -->
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">Products & Systems</h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={formatUrl('/products/transformers')} class="hover:text-white transition-colors text-slate-300">
              Distribution Transformers (100–3000 kVA)
            </a>
          </li>
          <li>
            <a href={formatUrl('/products/lt-switchgear')} class="hover:text-white transition-colors text-slate-300">
              LT Switchgear Panels (800A–6300A)
            </a>
          </li>
          <li>
            <a href={formatUrl('/products/pfi-systems')} class="hover:text-white transition-colors text-slate-300">
              Automatic PFI Plants & Capacitors
            </a>
          </li>
          <li>
            <a href={formatUrl('/products/ht-switchgear')} class="hover:text-white transition-colors text-slate-300">
              11 kV HT Switchgear (ABB VD4 VCB)
            </a>
          </li>
          <li>
            <a href={formatUrl('/products/industrial-automation')} class="hover:text-white transition-colors text-slate-300">
              PLC, SCADA & Motor Control Centers
            </a>
          </li>
          <li>
            <a href={formatUrl('/services')} class="hover:text-white transition-colors text-slate-300">
              Substation AMC & Testing Services
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Works & Contact -->
      <div class="space-y-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-4">Works & Engineering Office</h2>
        <address class="not-italic text-xs text-slate-400 leading-relaxed">
          {company.address.full}
        </address>
        <div class="pt-2 text-xs space-y-1.5 text-slate-300">
          <p>
            <strong class="text-white">Emergency 24/7:</strong>{' '}
            <a href={`tel:${company.contact.primaryPhone.replace(/\s+/g, '')}`} class="text-amber-400 hover:underline">
              {company.contact.primaryPhone}
            </a>
          </p>
          <p>
            <strong class="text-white">Corporate:</strong>{' '}
            <a href={`tel:${company.contact.secondaryPhone.replace(/\s+/g, '')}`} class="hover:underline">
              {company.contact.secondaryPhone}
            </a>
          </p>
          <p>
            <strong class="text-white">Email:</strong>{' '}
            <a href={`mailto:${company.contact.email}`} class="hover:underline">
              {company.contact.email}
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Certifications Ribbon -->
    <div class="mt-12 pt-8 border-t border-slate-800">
      <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4 text-center sm:text-left">
        Accreditations & Compliance Credentials
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 text-xs text-slate-400">
        {company.certifications.map((cert: string) => (
          <div class="flex items-start bg-slate-900/60 p-2.5 rounded border border-slate-800/80">
            <svg class="w-4 h-4 text-green-400 mr-2 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{cert}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom Copyright Bar -->
  <div class="bg-black/80 py-4 px-4 sm:px-6 lg:px-8 border-t border-slate-900 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <p>&copy; {currentYear} {company.legalName}. All rights reserved.</p>
      <p class="text-center sm:text-right">
        Industrial Electrical Substation & Automation Engineering in Dhaka, Bangladesh
      </p>
    </div>
  </div>
</footer>

