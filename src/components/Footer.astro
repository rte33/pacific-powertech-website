---
import { getSiteSettings, formatUrl } from '../utils/content';
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';

const site = getSiteSettings();
const company = site.company;
const currentYear = new Date().getFullYear();

// Dynamically resolve logo image to eliminate mixed static/dynamic Vite warnings
const logoStacked = await resolveImage(company.branding.logoStacked);
---

<footer class="bg-[#070707] text-gray-300 border-t-2 border-[#0C53A4]">
  <!-- Main Content Strip -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Col 1: Corporate Profile & Brand Mark -->
      <div class="space-y-3">
        <div class="bg-white p-2 inline-block border border-gray-300 max-w-[190px]">
          {logoStacked ? (
            <Image
              src={logoStacked}
              alt={company.name}
              class="h-12 w-auto object-contain"
              height={48}
            />
          ) : (
            <span class="font-heading font-bold text-[#0C53A4] text-lg uppercase tracking-wider">{company.name}</span>
          )}
        </div>
        <p class="text-xs text-gray-400 leading-relaxed font-sans">
          {company.tagline}
        </p>
        <div class="text-xs text-gray-400 border-t border-gray-800 pt-2.5 space-y-1">
          <p><strong class="text-gray-200">Established:</strong> 2013 in Dhaka, Bangladesh</p>
          <p><strong class="text-gray-200">Engineering Staff:</strong> 23 Engineers &amp; Technicians</p>
          <p><strong class="text-gray-200">Standards:</strong> IEC 76, BS, ANSI, VDE, BNBC</p>
        </div>
      </div>

      <!-- Col 2: Navigation Links -->
      <div>
        <h2 class="font-heading text-sm font-bold uppercase tracking-wider text-[#FAB218] mb-3 pb-1 border-b border-gray-800">
          Navigation
        </h2>
        <ul class="space-y-1.5 text-xs text-gray-300 font-sans">
          {site.navigation.map((item: any) => (
            <li>
              <a href={formatUrl(item.path)} class="hover:text-white transition-colors flex items-center gap-1.5 py-0.5">
                <span class="text-[#D81A21]">&rsaquo;</span>
                {item.title}
              </a>
            </li>
          ))}
          <li>
            <a href={formatUrl('/assets/PPL Catalog.pdf')} download="Pacific-Powertech-Catalog.pdf" class="hover:text-white transition-colors flex items-center gap-1.5 py-0.5 text-gray-200 font-semibold">
              <span class="text-[#D81A21]">&rsaquo;</span>
              Download Catalog PDF (1.2 MB)
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Core Engineering Products -->
      <div>
        <h2 class="font-heading text-sm font-bold uppercase tracking-wider text-[#FAB218] mb-3 pb-1 border-b border-gray-800">
          Products &amp; Equipment
        </h2>
        <ul class="space-y-1.5 text-xs text-gray-300 font-sans">
          <li>
            <a href={formatUrl('/products/transformers')} class="hover:text-white transition-colors block py-0.5">
              Distribution Transformers (100–3000 kVA)
            </a>
          </li>
          <li>
            <a href={formatUrl('/products/lt-switchgear')} class="hover:text-white transition-colors block py-0.5">
              LT Switchgear &amp; ACB Panels (800A–6300A)
            </a>
          </li>
          <li>
            <a href={formatUrl('/products/pfi-systems')} class="hover:text-white transition-colors block py-0.5">
              Automatic PFI Plants &amp; Capacitor Banks
            </a>
          </li>
          <li>
            <a href={formatUrl('/products/ht-switchgear')} class="hover:text-white transition-colors block py-0.5">
              11 kV HT Switchgear (ABB VD4 VCB)
            </a>
          </li>
          <li>
            <a href={formatUrl('/products/industrial-automation')} class="hover:text-white transition-colors block py-0.5">
              PLC, SCADA &amp; Motor Control Centers
            </a>
          </li>
          <li>
            <a href={formatUrl('/services')} class="hover:text-white transition-colors block py-0.5">
              Substation AMC &amp; Load Sanctions
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Corporate Works & Contacts -->
      <div>
        <h2 class="font-heading text-sm font-bold uppercase tracking-wider text-[#FAB218] mb-3 pb-1 border-b border-gray-800">
          Works &amp; Contacts
        </h2>
        <address class="not-italic text-xs text-gray-400 leading-relaxed font-sans">
          Plot # 2249, Munshibari Goli, Shatarkul Road,<br />
          Uttar Badda, Dhaka-1212, Bangladesh
        </address>
        <div class="mt-3 text-xs space-y-1 text-gray-300 font-sans tabular-nums">
          <p>
            <strong class="text-gray-200">24/7 Hotline:</strong>{' '}
            <a href={`tel:${company.contact.primaryPhone.replace(/\s+/g, '')}`} class="text-[#FAB218] hover:underline">
              {company.contact.primaryPhone}
            </a>
          </p>
          <p>
            <strong class="text-gray-200">Corporate:</strong>{' '}
            <a href={`tel:${company.contact.secondaryPhone.replace(/\s+/g, '')}`} class="hover:text-white">
              {company.contact.secondaryPhone}
            </a>
          </p>
          <p>
            <strong class="text-gray-200">Email:</strong>{' '}
            <a href={`mailto:${company.contact.email}`} class="text-gray-300 hover:text-white">
              {company.contact.email}
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- Accreditations Strip -->
    <div class="mt-8 pt-6 border-t border-gray-800">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2.5 text-[11px] text-gray-400">
        <div class="flex items-center gap-2 bg-black/50 px-3 py-2 border border-gray-800">
          <span class="w-1.5 h-1.5 bg-[#FAB218]"></span>
          <span>Approved Test Lab by BSTI</span>
        </div>
        <div class="flex items-center gap-2 bg-black/50 px-3 py-2 border border-gray-800">
          <span class="w-1.5 h-1.5 bg-[#FAB218]"></span>
          <span>BUET Tested &amp; Certified Instruments</span>
        </div>
        <div class="flex items-center gap-2 bg-black/50 px-3 py-2 border border-gray-800">
          <span class="w-1.5 h-1.5 bg-[#FAB218]"></span>
          <span>Ministry of Power Electrical Licensing Authority</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Bar -->
  <div class="bg-black py-3.5 px-4 sm:px-6 lg:px-8 border-t border-gray-900 text-[11px] text-gray-400">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
      <p>&copy; {currentYear} {company.legalName}. All rights reserved.</p>
      <p>Industrial Electrical Substation &amp; Automation Manufacturing &bull; Dhaka, Bangladesh</p>
    </div>
  </div>
</footer>
