---
import { Image } from 'astro:assets';
import { getSiteSettings, formatUrl } from '../utils/content';
import { resolveImage } from '../utils/assets';
import BrandLockup from './BrandLockup.astro';

const site = getSiteSettings();
const company = site.company;
const currentYear = new Date().getFullYear();
const approvalTick = await resolveImage(company.branding.approvalTick);
const approvalMarks = await Promise.all(
  (company.approvalMarks || []).map(async (mark: any) => ({
    ...mark,
    imgMeta: await resolveImage(mark.logo),
  }))
);
---

<footer class="border-t border-white/10 bg-[#020d17] text-slate-300">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <a href={formatUrl('/')} class="inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FAB218]" aria-label="Pacific Powertech home">
          <BrandLockup />
        </a>
        <p class="mt-5 max-w-sm text-base leading-7 text-slate-300">{company.tagline}</p>
        <p class="mt-5 text-sm leading-6 text-slate-400">
          Established {company.established} · Dhaka, Bangladesh<br />
          Engineered to IEC, BS, ANSI, VDE and BNBC requirements.
        </p>
      </div>

      <div class="lg:col-span-2">
        <h2 class="mb-4 text-sm font-bold tracking-wide text-[#FAB218]">Explore</h2>
        <ul class="space-y-2.5 text-sm">
          {site.navigation.map((item: any) => (
            <li><a href={formatUrl(item.path)} class="hover:text-white">{item.title}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h2 class="mb-4 text-sm font-bold tracking-wide text-[#FAB218]">Core Systems</h2>
        <ul class="space-y-2.5 text-sm leading-6">
          <li><a href={formatUrl('/products/transformers')} class="hover:text-white">Distribution Transformers</a></li>
          <li><a href={formatUrl('/products/lt-switchgear')} class="hover:text-white">LT Switchgear &amp; ACB Panels</a></li>
          <li><a href={formatUrl('/products/pfi-systems')} class="hover:text-white">PFI Plants &amp; Capacitor Banks</a></li>
          <li><a href={formatUrl('/products/ht-switchgear')} class="hover:text-white">11 kV HT Switchgear</a></li>
          <li><a href={formatUrl('/products/industrial-automation')} class="hover:text-white">PLC, SCADA &amp; Motor Control</a></li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h2 class="mb-4 text-sm font-bold tracking-wide text-[#FAB218]">Engineering Desk</h2>
        <address class="text-sm not-italic leading-6 text-slate-400">{company.address.full}</address>
        <div class="mt-5 space-y-2 text-sm tabular-nums">
          <p><span class="text-slate-400">Hotline</span><br /><a href={`tel:${company.contact.primaryPhone.replace(/\s+/g, '')}`} class="font-bold text-white hover:text-[#FAB218]">{company.contact.primaryPhone}</a></p>
          <p><span class="text-slate-400">Email</span><br /><a href={`mailto:${company.contact.email}`} class="text-white hover:text-[#FAB218]">{company.contact.email}</a></p>
        </div>
      </div>
    </div>

    {approvalMarks.length > 0 && (
      <div class="mt-10 border-t border-white/10 pt-6" aria-labelledby="certifications-heading">
        <h2 id="certifications-heading" class="text-xs font-bold uppercase tracking-[0.18em] text-[#FAB218]">
          Certifications &amp; Approvals
        </h2>
        <ul class="mt-5 grid gap-x-10 gap-y-5 sm:grid-cols-3" aria-label="Certification and approval bodies">
          {approvalMarks.map((mark: any) => (
            <li class="flex min-h-12 items-center gap-3 text-sm font-semibold leading-5 text-slate-200">
              {mark.imgMeta ? (
                <Image
                  src={mark.imgMeta}
                  alt={mark.altText}
                  class="h-11 w-14 shrink-0 object-contain"
                  width={56}
                  height={44}
                  loading="lazy"
                />
              ) : (
                <span class="w-14 shrink-0 text-xs font-bold text-white">{mark.name}</span>
              )}
              {approvalTick && (
                <span
                  class="h-5 w-5 shrink-0 bg-[#FAB218]"
                  style={`-webkit-mask: url(${approvalTick.src}) center / contain no-repeat; mask: url(${approvalTick.src}) center / contain no-repeat;`}
                  aria-hidden="true"
                ></span>
              )}
              <span>{mark.statement}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <div class="border-t border-white/10 bg-black/30 px-4 py-4 text-xs text-slate-400 sm:px-6 lg:px-8">
    <div class="mx-auto flex max-w-7xl flex-col justify-between gap-2 sm:flex-row sm:items-center">
      <p>&copy; {currentYear} {company.legalName} All rights reserved.</p>
      <a href={formatUrl('/assets/PPL Catalog.pdf')} download="Pacific-Powertech-Catalog.pdf" class="font-semibold text-slate-300 hover:text-white">Download technical catalog (PDF)</a>
    </div>
  </div>
</footer>
