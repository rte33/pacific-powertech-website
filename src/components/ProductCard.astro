---
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';
import { formatUrl } from '../utils/content';

interface Props {
  title: string;
  image: string;
  summary: string;
  highlights?: string[];
  url: string;
}

const { title, image, summary, highlights = [], url } = Astro.props;
const imgMeta = await resolveImage(image);
---

<article class="group flex flex-col border border-slate-300 bg-white transition-colors duration-150 hover:border-[#0C53A4]">
  <!-- Image Frame with Restrained Aspect Ratio -->
  <div class="relative aspect-[16/10] overflow-hidden border-b border-slate-200 bg-slate-100">
    {imgMeta ? (
      <Image
        src={imgMeta}
        alt={title}
        class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-[1.02]"
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      />
    ) : (
      <div class="flex h-full w-full items-center justify-center text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">
        Image pending
      </div>
    )}
  </div>

  <!-- Content Block -->
  <div class="flex flex-1 flex-col justify-between p-5">
    <div>
      <h3 class="font-heading text-xl font-bold leading-tight text-[#031525] transition-colors group-hover:text-[#0C53A4] sm:text-2xl">
        <a href={formatUrl(url)} class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]">
          {title}
        </a>
      </h3>
      <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-600">
        {summary}
      </p>

      {highlights.length > 0 && (
        <ul class="mt-4 space-y-1.5 border-t border-slate-200 pt-3 text-sm text-slate-700">
          {highlights.map((point) => (
            <li class="flex items-start gap-1.5">
              <span class="text-[#0C53A4] font-bold">&ndash;</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Technical Action Link -->
    <div class="mt-5 flex items-center justify-between border-t border-slate-200 pt-3">
      <a
        href={formatUrl(url)}
        class="text-xs font-bold uppercase tracking-wider text-[#0C53A4] hover:text-[#213C94] flex items-center gap-1.5"
      >
        <span>Specifications &amp; Drawings</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</article>
