---
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';
import { formatUrl } from '../utils/content';

interface Props {
  title: string;
  image: string;
  summary: string;
  highlights?: string[];
  url: string;
}

const { title, image, summary, highlights = [], url } = Astro.props;
const imgMeta = await resolveImage(image);
---

<div class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all overflow-hidden flex flex-col group">
  <!-- Card Image -->
  <div class="aspect-[16/10] bg-slate-100 overflow-hidden relative">
    {imgMeta ? (
      <Image
        src={imgMeta}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-slate-400">
        Image placeholder
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
  </div>

  <!-- Card Body -->
  <div class="p-6 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-xl font-bold text-slate-900 group-hover:text-pptl-blue transition-colors">
        <a href={formatUrl(url)} class="focus:outline-none focus:underline">
          {title}
        </a>
      </h3>
      <p class="text-sm text-slate-600 mt-2 line-clamp-3 leading-relaxed">
        {summary}
      </p>

      {highlights.length > 0 && (
        <ul class="mt-4 space-y-1.5 text-xs text-slate-500 border-t border-slate-100 pt-3">
          {highlights.map((point) => (
            <li class="flex items-start">
              <span class="text-pptl-blue mr-1.5 font-bold">&bull;</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Card Action Link -->
    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
      <a
        href={formatUrl(url)}
        class="text-xs font-bold uppercase tracking-wider text-pptl-blue hover:text-blue-800 flex items-center gap-1 group-hover:translate-x-1 transition-transform"
      >
        Technical Details &amp; Specs
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>

