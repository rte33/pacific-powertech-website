---
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';
import { formatUrl } from '../utils/content';

interface Props {
  title: string;
  image: string;
  summary: string;
  highlights?: string[];
  url: string;
}

const { title, image, summary, highlights = [], url } = Astro.props;
const imgMeta = await resolveImage(image);
---

<article class="bg-white border border-gray-300 hover:border-[#0C53A4] transition-colors duration-150 flex flex-col group">
  <!-- Image Frame with Restrained Aspect Ratio -->
  <div class="aspect-[16/10] bg-gray-100 overflow-hidden relative border-b border-gray-200">
    {imgMeta ? (
      <Image
        src={imgMeta}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-200"
        widths={[320, 480, 640]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-xs text-gray-400 font-mono uppercase">
        Image pending
      </div>
    )}
  </div>

  <!-- Content Block -->
  <div class="p-5 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="font-heading text-xl sm:text-2xl font-bold uppercase tracking-tight text-gray-950 group-hover:text-[#0C53A4] transition-colors">
        <a href={formatUrl(url)} class="focus:outline-none focus:underline">
          {title}
        </a>
      </h3>
      <p class="text-xs text-gray-600 mt-2 line-clamp-3 leading-relaxed font-sans">
        {summary}
      </p>

      {highlights.length > 0 && (
        <ul class="mt-3.5 space-y-1 text-xs text-gray-700 border-t border-gray-100 pt-3 font-sans">
          {highlights.map((point) => (
            <li class="flex items-start gap-1.5">
              <span class="text-[#0C53A4] font-bold">&ndash;</span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Technical Action Link -->
    <div class="mt-5 pt-3 border-t border-gray-200 flex items-center justify-between">
      <a
        href={formatUrl(url)}
        class="text-xs font-bold uppercase tracking-wider text-[#0C53A4] hover:text-[#213C94] flex items-center gap-1.5"
      >
        <span>Specifications &amp; Drawings</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</article>
