---
import { getClients } from '../utils/content';
import { Image } from 'astro:assets';
import { resolveImage } from '../utils/assets';

const clientsData = getClients();
const allClients = clientsData.clients || [];
// Strictly filter only approved clients (Never show unapproved or disabled clients publicly)
const approvedClients = allClients.filter((c: any) => c.enabled === true);

// Pre-resolve approved images if any exist
const clientList = await Promise.all(
  approvedClients.map(async (client: any) => {
    const imgMeta = await resolveImage(client.logo);
    return { ...client, imgMeta };
  })
);
---

{clientList.length > 0 ? (
  <section class="py-12 bg-slate-100 border-t border-slate-200 overflow-hidden" aria-labelledby="clients-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 text-center">
      <h2 id="clients-heading" class="text-xs font-bold uppercase tracking-widest text-pptl-blue">
        Companies We've Worked With
      </h2>
      <p class="text-lg font-bold text-slate-900 mt-1">
        Trusted by Industrial Leaders & Utilities Across Bangladesh
      </p>
    </div>

    <!-- Controls for Accessible Manual Pause/Play -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-end mb-4">
      <button
        id="carousel-toggle-btn"
        class="text-xs font-semibold text-slate-600 hover:text-pptl-blue bg-white border border-slate-300 rounded px-2.5 py-1 flex items-center gap-1.5 focus:ring-2 focus:ring-pptl-blue"
        aria-pressed="false"
      >
        <span id="carousel-toggle-text">Pause Animation</span>
      </button>
    </div>

    <!-- Reduced-Motion Static Grid Fallback -->
    <div class="hidden prefers-reduced-motion-block max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-6 items-center">
        {clientList.map((client) => (
          <div class="flex items-center justify-center p-4 bg-white rounded-lg border border-slate-200 shadow-sm h-24">
            {client.imgMeta ? (
              <Image
                src={client.imgMeta}
                alt={client.altText || client.name}
                class="max-h-14 w-auto object-contain grayscale hover:grayscale-0 transition-all"
                height={56}
              />
            ) : (
              <span class="text-sm font-semibold text-slate-700 text-center">{client.name}</span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- Animated Continuous Marquee Track -->
    <div class="marquee-wrapper relative w-full overflow-hidden group py-2">
      <!-- Gradient Fades on edges -->
      <div class="absolute left-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-r from-slate-100 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>
      <div class="absolute right-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-l from-slate-100 to-transparent z-10 pointer-events-none" aria-hidden="true"></div>

      <div id="marquee-track" class="marquee-track flex gap-8 w-max items-center animate-marquee group-hover:[animation-play-state:paused] focus-within:[animation-play-state:paused]">
        <!-- Primary List (Accessible to Screen Readers) -->
        <div class="flex gap-8 items-center" role="list" aria-label="Client company logos">
          {clientList.map((client) => (
            <div role="listitem" class="flex items-center justify-center bg-white px-6 py-4 rounded-lg border border-slate-200 shadow-sm h-24 min-w-[180px]">
              {client.imgMeta ? (
                <Image
                  src={client.imgMeta}
                  alt={client.altText || client.name}
                  class="max-h-14 w-auto object-contain transition-all"
                  height={56}
                />
              ) : (
                <span class="text-sm font-semibold text-slate-800 text-center">{client.name}</span>
              )}
            </div>
          ))}
        </div>

        <!-- Duplicated List for Seamless Looping (Hidden from Screen Readers to prevent redundant announcements) -->
        <div class="flex gap-8 items-center" aria-hidden="true">
          {clientList.map((client) => (
            <div class="flex items-center justify-center bg-white px-6 py-4 rounded-lg border border-slate-200 shadow-sm h-24 min-w-[180px]">
              {client.imgMeta ? (
                <Image
                  src={client.imgMeta}
                  alt=""
                  class="max-h-14 w-auto object-contain transition-all"
                  height={56}
                />
              ) : (
                <span class="text-sm font-semibold text-slate-800 text-center">{client.name}</span>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
) : (
  <!-- When zero clients are enabled per launch governance, render a discrete placeholder notice for owners or clean divider -->
  <section class="py-6 bg-slate-50 border-t border-slate-200 text-center text-xs text-slate-400" aria-label="Client Sign-Off Section">
    <div class="max-w-7xl mx-auto px-4">
      <p class="font-medium text-slate-500">
        Pacific Powertech Ltd. &bull; Engineered to IEC, BS, ANSI & VDE Standards &bull; Trusted Since 2013
      </p>
    </div>
  </section>
)}

<style>
  @media (prefers-reduced-motion: reduce) {
    .marquee-wrapper {
      display: none !important;
    }
    .prefers-reduced-motion-block {
      display: block !important;
    }
  }

  .paused {
    animation-play-state: paused !important;
  }
</style>

<script>
  const toggleBtn = document.getElementById('carousel-toggle-btn');
  const marqueeTrack = document.getElementById('marquee-track');
  const toggleText = document.getElementById('carousel-toggle-text');

  if (toggleBtn && marqueeTrack && toggleText) {
    toggleBtn.addEventListener('click', () => {
      const isPaused = marqueeTrack.classList.contains('paused');
      if (isPaused) {
        marqueeTrack.classList.remove('paused');
        toggleText.textContent = 'Pause Animation';
        toggleBtn.setAttribute('aria-pressed', 'false');
      } else {
        marqueeTrack.classList.add('paused');
        toggleText.textContent = 'Play Animation';
        toggleBtn.setAttribute('aria-pressed', 'true');
      }
    });
  }
</script>

