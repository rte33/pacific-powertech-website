---
import { Image } from 'astro:assets';
import { getClients } from '../utils/content';
import { resolveImage } from '../utils/assets';

const clientsData = getClients();
const approvedClients = (clientsData.clients || [])
  .filter((client: any) => client.enabled === true)
  .sort((a: any, b: any) => a.order - b.order);

const clientList = await Promise.all(
  approvedClients.map(async (client: any) => ({
    ...client,
    imgMeta: await resolveImage(client.logo),
  }))
);
---

{clientList.length > 0 && (
  <section id="technology-brands" class="border-t border-slate-300 bg-[#eef1f3] py-14 sm:py-16" aria-labelledby="technology-brands-heading" data-technology-brands>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="border-b border-[#031525]/20 pb-7">
        <div class="max-w-3xl">
          <h2 id="technology-brands-heading" class="font-heading text-2xl font-bold tracking-tight text-[#031525] sm:text-3xl">Technology &amp; Component Brands</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base">Current industrial brands specified across power distribution, switchgear and automation systems.</p>
        </div>
      </div>

      <ul class="mt-10 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3 md:grid-cols-5" aria-label="Technology and component brands">
        {clientList.map((client) => (
          <li>
            <a href={client.sourceUrl} target="_blank" rel="noopener noreferrer" class="group flex min-h-28 items-center justify-center px-4 py-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[#0C53A4]" aria-label={`${client.altText || client.name} — official website`}>
              {client.imgMeta ? (
                <Image
                  src={client.imgMeta}
                  alt={client.altText || client.name}
                  class:list={[
                    'h-12 w-36 object-contain transition-[filter,opacity] duration-200 group-hover:opacity-75',
                    client.id === 'schneider-electric' && 'brand-logo--schneider',
                    client.id === 'chint' && 'brand-logo--chint',
                  ]}
                  height={48}
                />
              ) : (
                <span class="text-center text-sm font-bold text-[#031525]">{client.name}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .brand-logo--schneider {
    filter: brightness(0) saturate(100%) invert(68%) sepia(78%) saturate(497%) hue-rotate(72deg) brightness(92%) contrast(91%);
  }

  .brand-logo--chint {
    transform: scale(1.35);
  }
</style>
