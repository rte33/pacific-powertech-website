---
interface Props {
  headers: string[];
  rows: string[][];
  notes?: string;
  caption?: string;
}

const { headers, rows, notes, caption = "Technical Engineering Specifications" } = Astro.props;
---

<div class="my-6">
  <div class="flex items-center justify-between mb-1.5">
    <span class="text-xs font-bold uppercase tracking-wider text-gray-700 font-heading">
      {caption}
    </span>
    <span class="text-xs text-[#0C53A4] md:hidden flex items-center font-medium font-sans">
      Scroll horizontally &rarr;
    </span>
  </div>

  <div class="table-responsive-container border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#0C53A4]" tabindex="0" role="region" aria-label={caption}>
    <table class="w-full text-left border-collapse" role="table">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          {headers.map((header) => (
            <th scope="col" class="py-2.5 px-3.5 whitespace-nowrap">
              {header}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 text-xs font-sans tabular-nums">
        {rows.map((row, idx) => (
          <tr class={idx % 2 === 0 ? 'bg-white hover:bg-blue-50/50' : 'bg-gray-50/80 hover:bg-blue-50/50'}>
            {row.map((cell, cellIdx) => (
              <td class={`py-2 px-3.5 text-gray-800 whitespace-nowrap ${cellIdx === 0 ? 'font-semibold text-black bg-gray-50/50' : ''}`}>
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {notes && (
    <p class="text-[11px] text-gray-700 italic mt-1 font-sans">
      * {notes}
    </p>
  )}
</div>
