---
interface Props {
  headers: string[];
  rows: string[][];
  notes?: string;
  caption?: string;
}

const { headers, rows, notes, caption = "Technical Engineering Specifications" } = Astro.props;
---

<div class="my-8">
  <div class="flex items-center justify-between mb-2">
    <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
      {caption}
    </span>
    <span class="text-xs text-pptl-blue md:hidden flex items-center font-medium">
      Swipe horizontally &rarr;
    </span>
  </div>

  <div class="table-responsive-container shadow-sm border border-slate-200">
    <table class="w-full text-left border-collapse" role="table">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr class="bg-slate-900 text-white text-xs uppercase tracking-wider font-semibold">
          {headers.map((header) => (
            <th scope="col" class="py-3 px-4 border-b border-slate-800 whitespace-nowrap">
              {header}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100 text-sm font-normal">
        {rows.map((row, idx) => (
          <tr class={idx % 2 === 0 ? 'bg-white hover:bg-blue-50/50 transition-colors' : 'bg-slate-50/80 hover:bg-blue-50/50 transition-colors'}>
            {row.map((cell, cellIdx) => (
              <td class={`py-2.5 px-4 text-slate-700 whitespace-nowrap ${cellIdx === 0 ? 'font-semibold text-slate-900' : ''}`}>
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {notes && (
    <p class="text-xs text-slate-500 italic mt-2">
      * {notes}
    </p>
  )}
</div>

