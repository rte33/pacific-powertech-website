---
interface Props {
  headers: string[];
  rows: string[][];
  notes?: string;
  caption?: string;
}

const { headers, rows, notes, caption = "Technical Engineering Specifications" } = Astro.props;
---

<div class="my-6">
  <div class="mb-2 flex items-center justify-between">
    <span class="text-xs font-bold uppercase tracking-[0.16em] text-slate-700">
      {caption}
    </span>
    <span class="text-xs text-[#0C53A4] md:hidden flex items-center font-medium font-sans">
      Scroll horizontally &rarr;
    </span>
  </div>

  <div class="table-responsive-container border border-slate-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0C53A4]" tabindex="0" role="region" aria-label={caption}>
    <table class="w-full text-left border-collapse" role="table">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr>
          {headers.map((header) => (
            <th scope="col" class="py-2.5 px-3.5 whitespace-nowrap">
              {header}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200 text-sm tabular-nums">
        {rows.map((row, idx) => (
          <tr class={idx % 2 === 0 ? 'bg-white hover:bg-blue-50/50' : 'bg-slate-50/80 hover:bg-blue-50/50'}>
            {row.map((cell, cellIdx) => (
              <td class={`whitespace-nowrap px-3.5 py-2.5 text-slate-800 ${cellIdx === 0 ? 'bg-slate-50/50 font-semibold text-[#031525]' : ''}`}>
                {cell}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  {notes && (
    <p class="mt-2 text-xs italic leading-5 text-slate-600">
      * {notes}
    </p>
  )}
</div>
